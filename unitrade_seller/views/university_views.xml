<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_unitrade_university_tree" model="ir.ui.view">
        <field name="name">unitrade.university.tree</field>
        <field name="model">unitrade.university</field>
        <field name="arch" type="xml">
            <tree string="Universitas" default_order="sequence, name">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="status"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_unitrade_university_form" model="ir.ui.view">
        <field name="name">unitrade.university.form</field>
        <field name="model">unitrade.university</field>
        <field name="arch" type="xml">
            <form string="Universitas">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="status"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_unitrade_university" model="ir.actions.act_window">
        <field name="name">Universitas</field>
        <field name="res_model">unitrade.university</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_unitrade_university"
              name="Universitas"
              parent="unitrade_seller.menu_unitrade_sellers"
              action="action_unitrade_university"
              sequence="35"
              groups="base.group_system"/>
</odoo>
