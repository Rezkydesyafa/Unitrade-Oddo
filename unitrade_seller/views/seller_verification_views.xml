<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ==============================
         FORM VIEW
    ============================== -->
    <record id="view_seller_verification_form" model="ir.ui.view">
        <field name="name">unitrade.seller.verification.form</field>
        <field name="model">unitrade.seller.verification</field>
        <field name="arch" type="xml">
            <form string="Verifikasi KTM Seller">
                <header>
                    <button name="action_approve" type="object"
                            string="Approve" class="btn-primary"
                            invisible="state not in ('pending', 'manual_review')"/>
                    <button name="action_reject" type="object"
                            string="Reject" class="btn-danger"
                            invisible="state not in ('pending', 'manual_review')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending,manual_review,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="partner_id" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informasi KTM">
                            <field name="university_id"/>
                            <field name="university_other" invisible="university_id"/>
                            <field name="ktm_image" widget="image" class="oe_avatar"/>
                            <field name="ktm_filename"/>
                            <field name="attachment_id"/>
                        </group>
                        <group string="Hasil OCR">
                            <field name="nim_extracted"/>
                            <field name="nim_valid"/>
                            <field name="nim_registered"/>
                            <field name="student_name"/>
                            <field name="name_match_token"/>
                            <field name="name_confidence"/>
                            <field name="confidence_flag"/>
                            <field name="duplicate_warning"/>
                            <field name="duplicate_seller_id" invisible="not duplicate_warning"/>
                        </group>
                    </group>
                    <group>
                        <group string="Audit Review">
                            <field name="rejection_reason"/>
                            <field name="review_note"/>
                            <field name="reviewed_by"/>
                            <field name="reviewed_date"/>
                            <field name="state_changed_by"/>
                            <field name="state_changed_at"/>
                        </group>
                        <group string="File &amp; Rate Limit">
                            <field name="image_width"/>
                            <field name="image_height"/>
                            <field name="upload_attempt_count"/>
                            <field name="upload_window_start"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="OCR Raw Text">
                            <field name="ocr_raw_text"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ==============================
         LIST VIEW
    ============================== -->
    <record id="view_seller_verification_tree" model="ir.ui.view">
        <field name="name">unitrade.seller.verification.tree</field>
        <field name="model">unitrade.seller.verification</field>
        <field name="arch" type="xml">
            <tree string="Verifikasi KTM Seller" decoration-warning="state in ('pending', 'manual_review')" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'">
                <field name="partner_id"/>
                <field name="university_id"/>
                <field name="university_other" optional="hide"/>
                <field name="nim_extracted"/>
                <field name="nim_valid"/>
                <field name="nim_registered"/>
                <field name="student_name"/>
                <field name="name_match_token"/>
                <field name="name_confidence" widget="float" digits="[4,3]"/>
                <field name="confidence_flag"/>
                <field name="duplicate_warning"/>
                <field name="reviewed_by"/>
                <field name="reviewed_date"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'pending'"
                       decoration-muted="state == 'manual_review'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
            </tree>
        </field>
    </record>

    <!-- ==============================
         SEARCH VIEW
    ============================== -->
    <record id="view_seller_verification_search" model="ir.ui.view">
        <field name="name">unitrade.seller.verification.search</field>
        <field name="model">unitrade.seller.verification</field>
        <field name="arch" type="xml">
            <search string="Cari Verifikasi">
                <field name="partner_id"/>
                <field name="university_id"/>
                <field name="university_other"/>
                <field name="nim_extracted"/>
                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_manual_review" string="Manual Review" domain="[('state', '=', 'manual_review')]"/>
                <filter name="filter_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="filter_rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="filter_low_confidence" string="Low Confidence" domain="[('confidence_flag', '=', 'low')]"/>
                <filter name="filter_high_confidence" string="High Confidence" domain="[('confidence_flag', '=', 'high')]"/>
                <filter name="filter_duplicate" string="Duplicate Warning" domain="[('duplicate_warning', '=', True)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_university" string="Universitas" context="{'group_by': 'university_id'}"/>
                    <filter name="group_confidence" string="Confidence Flag" context="{'group_by': 'confidence_flag'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ==============================
         ACTION
    ============================== -->
    <record id="action_seller_verification" model="ir.actions.act_window">
        <field name="name">Verifikasi Seller</field>
        <field name="res_model">unitrade.seller.verification</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_seller_verification_tree"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_seller_verification_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_seller_verification_form')})]"/>
        <field name="search_view_id" ref="view_seller_verification_search"/>
        <field name="context">{'search_default_filter_manual_review': 1}</field>
    </record>

    <record id="action_seller_verification_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard Verifikasi Seller</field>
        <field name="res_model">unitrade.seller.verification</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_seller_verification_tree"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_seller_verification_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_seller_verification_form')})]"/>
        <field name="domain">[('state', 'in', ('manual_review', 'pending'))]</field>
        <field name="search_view_id" ref="view_seller_verification_search"/>
        <field name="context">{'search_default_filter_manual_review': 1}</field>
    </record>

    <!-- ==============================
         MENU (under existing UniTrade root)
    ============================== -->
    <menuitem id="menu_seller_verification"
              name="Verifikasi Seller"
              parent="unitrade_seller.menu_unitrade_sellers"
              action="action_seller_verification"
              sequence="30"
              groups="base.group_system"/>

    <menuitem id="menu_seller_verification_dashboard"
              name="Dashboard Verifikasi"
              parent="unitrade_seller.menu_unitrade_sellers"
              action="action_seller_verification_dashboard"
              sequence="25"
              groups="base.group_system"/>

</odoo>
