<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="unitrade_seller.SellerProducts">
        <div t-att-class="rootClass">
            <t t-if="!state.ready || state.loading">
                <t t-call="unitrade_seller.SellerProductsSkeleton"/>
            </t>
            <t t-else="">
                <div class="ut-dash-stage ut-products-stage">
                    <div class="ut-dash-promo tw-flex tw-items-center tw-justify-between tw-bg-white tw-px-[57px] tw-text-[12px] tw-leading-6 tw-text-black">
                        <div class="tw-flex tw-items-center tw-gap-[18px]">
                            <span>Gratis Ongkir + Diskon 30%</span>
                            <a href="/shop" class="tw-font-semibold tw-text-black tw-no-underline">Belanja Sekarang +</a>
                            <span class="tw-font-semibold tw-text-[#939393]">|</span>
                            <a href="/seller-onboarding" class="tw-font-semibold tw-text-black tw-no-underline">Mulai Berjualan</a>
                        </div>
                        <div class="tw-flex tw-items-center tw-gap-[18px]">
                            <a href="/help" class="tw-text-black tw-no-underline">Bantuan</a>
                            <a href="/contactus" class="tw-text-black tw-no-underline">Kontak</a>
                            <span class="tw-font-semibold tw-text-[#939393]">|</span>
                            <span>Ikuti kami :</span>
                            <span class="tw-flex tw-gap-2 tw-text-[12px]">
                                <i class="fa fa-instagram"></i>
                                <i class="fa fa-facebook-official"></i>
                                <i class="fa fa-music"></i>
                            </span>
                        </div>
                    </div>

                    <header class="ut-dash-navbar tw-absolute tw-left-8 tw-right-8 tw-top-[46px] tw-flex tw-h-[70px] tw-items-center tw-rounded-[54px] tw-bg-white tw-px-[14px] tw-shadow-[0_6px_8.95px_rgba(0,0,0,0.05)]">
                        <a href="/" class="tw-flex tw-h-[52px] tw-w-[129px] tw-items-center tw-gap-2 tw-rounded-full tw-px-[15px] tw-text-black tw-no-underline">
                            <img src="/unitrade_theme/static/src/img/logo-unitrade.png" alt="UniTrade" class="tw-h-[37px] tw-w-[41px] tw-object-contain"/>
                            <span class="tw-text-[12px] tw-font-bold">UniTrade</span>
                        </a>
                        <div class="tw-ml-[25px] tw-flex tw-h-12 tw-flex-1 tw-max-w-[658px] tw-items-center tw-rounded-[22.5px] tw-bg-[#f9f9f9] tw-pl-8 tw-pr-[5px]">
                            <input t-model="state.query" type="search" class="tw-min-w-0 tw-flex-1 tw-border-0 tw-bg-transparent tw-text-[12px] tw-text-[#212529] tw-outline-none placeholder:tw-text-[#939393]" placeholder="Cari produk di UniTrade"/>
                            <button type="button" class="tw-flex tw-size-[38px] tw-items-center tw-justify-center tw-rounded-full tw-border-0 tw-bg-[#212529] tw-text-white" aria-label="Cari produk">
                                <i class="fa fa-search"></i>
                            </button>
                        </div>
                        <div class="tw-ml-auto tw-flex tw-items-center tw-gap-[25px]">
                            <a href="/unitrade/seller/chat" class="ut-dash-nav-round tw-relative" aria-label="Chat Pembeli">
                                <i class="fa fa-commenting-o"></i>
                                <t t-if="stats.unread_chat_count">
                                    <span class="ut-dash-navbar-dot" t-esc="stats.unread_chat_count"></span>
                                </t>
                            </a>
                            <a href="/shop/cart" class="ut-dash-nav-round" aria-label="Keranjang">
                                <i class="fa fa-shopping-cart"></i>
                            </a>
                            <a href="/unitrade/seller/orders" class="ut-dash-nav-round tw-relative" aria-label="Notifikasi">
                                <i class="fa fa-bell-o"></i>
                                <t t-if="stats.notification_count">
                                    <span class="ut-dash-navbar-dot" t-esc="stats.notification_count"></span>
                                </t>
                            </a>
                            <span class="tw-h-[38.5px] tw-w-px tw-bg-[#e5e7eb]"></span>
                            <a href="/unitrade/seller/dashboard" class="ut-dash-nav-round" aria-label="Dashboard seller">
                                <i class="fa fa-truck"></i>
                            </a>
                            <img t-att-src="seller.avatar_url" alt="Avatar penjual" class="tw-size-[45px] tw-rounded-full tw-object-cover"/>
                            <span class="tw-mr-5 tw-max-w-[150px] tw-overflow-hidden tw-text-ellipsis tw-whitespace-nowrap tw-text-[16px] tw-font-medium tw-leading-6 tw-text-[#212529]" t-esc="seller.name"></span>
                        </div>
                        <button type="button" class="ut-dash-mobile-menu tw-hidden tw-border-0 tw-bg-transparent tw-text-[24px]" t-on-click="toggleSidebar" aria-label="Buka navigasi">
                            <i class="fa fa-bars"></i>
                        </button>
                    </header>

                    <div class="ut-dash-mobile-scrim" t-on-click="closeSidebar"></div>
                    <t t-call="unitrade_seller.SellerSidebar"/>

                    <main class="ut-products-main tw-absolute tw-left-[181px] tw-right-[67px] tw-top-[175px] tw-pb-10">
                        <section class="tw-mb-[34px]">
                            <h1 class="tw-m-0 tw-text-[40px] tw-font-normal tw-leading-none tw-text-black">Barang</h1>
                            <p class="tw-m-0 tw-mt-[7px] tw-text-[16px] tw-leading-6 tw-text-[#6a7282]">Kelola barang yang tampil di toko Anda.</p>
                        </section>

                        <div class="tw-mb-[22px] tw-flex tw-items-center tw-gap-3">
                            <label class="ut-products-date-filter">
                                <i class="fa fa-calendar-o"></i>
                                <select t-model="state.dateFilter" t-on-change="onDateFilterChange" aria-label="Filter tanggal barang">
                                    <option value="7">7 hari terakhir</option>
                                    <option value="30">30 hari terakhir</option>
                                    <option value="all">Semua waktu</option>
                                </select>
                                <i class="fa fa-angle-down"></i>
                            </label>
                            <a t-att-href="addProductUrl" class="ut-products-add-button">
                                <i class="fa fa-plus"></i>
                                <span>Tambah Barang</span>
                            </a>
                        </div>

                        <section class="ut-products-card">
                            <div class="tw-flex tw-h-7 tw-items-center tw-justify-between">
                                <h2 class="tw-m-0 tw-text-[18px] tw-font-semibold tw-leading-7 tw-text-[#0a0a0a]">Semua Barang</h2>
                            </div>
                            <div t-if="state.error" class="tw-mt-8 tw-rounded-[16px] tw-border tw-border-red-200 tw-bg-red-50 tw-px-5 tw-py-4 tw-text-[14px] tw-font-semibold tw-text-red-700" t-esc="state.error"></div>
                            <div t-elif="filteredProducts.length" class="tw-mt-8 tw-overflow-x-auto">
                                <table class="ut-products-table tw-w-full tw-min-w-[1115px]">
                                    <thead>
                                        <tr>
                                            <th>PRODUK ID</th>
                                            <th>GAMBAR</th>
                                            <th>NAMA PRODUK</th>
                                            <th>TANGGAL UPDATE</th>
                                            <th>STOK</th>
                                            <th>KONDISI</th>
                                            <th>AKSI</th>
                                            <th>TANGGAL</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="filteredProducts" t-as="product" t-key="productKey(product)">
                                            <tr>
                                                <td><strong t-esc="product.product_code"></strong></td>
                                                <td>
                                                    <img t-att-src="product.image_url" t-att-alt="product.name" class="tw-size-[51px] tw-rounded-[10px] tw-object-cover"/>
                                                </td>
                                                <td>
                                                    <span class="tw-block tw-max-w-[150px] tw-overflow-hidden tw-text-ellipsis tw-whitespace-nowrap tw-text-[#0a0a0a]" t-esc="product.name"></span>
                                                </td>
                                                <td t-esc="product.date_label"></td>
                                                <td t-esc="product.stock_label"></td>
                                                <td>
                                                    <span t-att-class="conditionClass(product)" t-esc="product.condition_label"></span>
                                                </td>
                                                <td>
                                                    <a t-att-href="product.edit_url" class="ut-products-link">Edit</a>
                                                </td>
                                                <td>
                                                    <span class="ut-products-link" t-esc="product.expiry_label"></span>
                                                </td>
                                                <td>
                                                    <a t-att-href="product.detail_url" class="ut-products-link">Lihat</a>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <div t-else="" class="tw-mt-8 tw-rounded-[18px] tw-border tw-border-dashed tw-border-[#d8dce4] tw-bg-[#fbfbfc] tw-p-8 tw-text-center tw-text-[14px] tw-font-semibold tw-text-[#6a7282]">
                                Belum ada barang di toko ini.
                            </div>
                        </section>
                    </main>
                </div>
            </t>
        </div>
    </t>

    <t t-name="unitrade_seller.SellerProductsSkeleton">
        <div class="ut-dash-stage ut-products-stage ut-dash-skeleton-stage">
            <div class="ut-dash-promo tw-flex tw-items-center tw-justify-between tw-bg-white tw-px-[57px]">
                <span class="ut-dash-skeleton-line tw-w-[280px]"></span>
                <span class="ut-dash-skeleton-line tw-w-[210px]"></span>
            </div>
            <header class="ut-dash-navbar tw-absolute tw-left-8 tw-right-8 tw-top-[46px] tw-flex tw-h-[70px] tw-items-center tw-rounded-[54px] tw-bg-white tw-px-[14px] tw-shadow-[0_6px_8.95px_rgba(0,0,0,0.05)]">
                <span class="ut-dash-skeleton-circle tw-size-[41px]"></span>
                <span class="ut-dash-skeleton-line tw-ml-3 tw-w-[74px]"></span>
                <span class="ut-dash-skeleton-block tw-ml-[55px] tw-h-12 tw-flex-1 tw-max-w-[658px] tw-rounded-[22px]"></span>
                <span class="ut-dash-skeleton-circle tw-ml-auto tw-size-[38px]"></span>
                <span class="ut-dash-skeleton-circle tw-size-[38px]"></span>
                <span class="ut-dash-skeleton-circle tw-size-[38px]"></span>
                <span class="ut-dash-skeleton-circle tw-size-[45px]"></span>
                <span class="ut-dash-skeleton-line tw-w-[116px]"></span>
            </header>
            <aside class="ut-dash-sidebar ut-products-sidebar ut-dash-skeleton-sidebar">
                <div class="ut-dash-sidebar-brand">
                    <span class="ut-dash-skeleton-block tw-size-8 tw-rounded-[10px]"></span>
                </div>
                <div class="ut-dash-sidebar-nav">
                    <span class="ut-dash-skeleton-block tw-h-10 tw-w-[52px] tw-rounded-[14px]"></span>
                    <span class="ut-dash-skeleton-block tw-h-10 tw-w-[52px] tw-rounded-[14px]"></span>
                    <span class="ut-dash-skeleton-block tw-h-10 tw-w-[52px] tw-rounded-[14px]"></span>
                    <span class="ut-dash-skeleton-block tw-h-10 tw-w-[52px] tw-rounded-[14px]"></span>
                    <span class="ut-dash-skeleton-block tw-h-10 tw-w-[52px] tw-rounded-[14px]"></span>
                    <span class="ut-dash-skeleton-block tw-h-10 tw-w-[52px] tw-rounded-[14px]"></span>
                </div>
                <div class="ut-dash-sidebar-footer">
                    <span class="ut-dash-skeleton-block tw-h-10 tw-w-[52px] tw-rounded-[14px]"></span>
                    <span class="ut-dash-skeleton-block tw-h-10 tw-w-[52px] tw-rounded-[14px]"></span>
                </div>
            </aside>
            <main class="ut-products-main tw-absolute tw-left-[181px] tw-right-[67px] tw-top-[175px] tw-pb-10">
                <section class="tw-mb-[34px]">
                    <span class="ut-dash-skeleton-line tw-h-11 tw-w-[170px] tw-rounded-[16px]"></span>
                    <span class="ut-dash-skeleton-line tw-mt-3 tw-h-5 tw-w-[430px]"></span>
                </section>
                <div class="tw-mb-[22px] tw-flex tw-gap-3">
                    <span class="ut-dash-skeleton-block tw-h-[38px] tw-w-[161px] tw-rounded-[10px]"></span>
                    <span class="ut-dash-skeleton-block tw-h-[38px] tw-w-[162px] tw-rounded-[10px]"></span>
                </div>
                <section class="ut-dash-skeleton-card tw-h-[434px] tw-p-[25px]">
                    <span class="ut-dash-skeleton-line tw-h-7 tw-w-[140px]"></span>
                    <span class="ut-dash-skeleton-block tw-mt-10 tw-h-[292px] tw-w-full tw-rounded-[14px]"></span>
                </section>
            </main>
        </div>
    </t>
</templates>
