<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="unitrade_seller.SellerRefunds">
        <div t-att-class="rootClass">
            <t t-if="!state.ready || state.loading">
                <t t-call="unitrade_seller.SellerRefundsSkeleton"/>
            </t>
            <t t-else="">
                <div class="ut-dash-stage ut-refunds-stage">
                    <div class="ut-dash-promo tw-flex tw-items-center tw-justify-between tw-bg-white tw-px-[57px] tw-text-[12px] tw-leading-6 tw-text-black">
                        <div class="tw-flex tw-items-center tw-gap-[18px]">
                            <span>Gratis Ongkir + Diskon 30%</span>
                            <a href="/shop" class="tw-font-semibold tw-text-black tw-no-underline">Belanja Sekarang +</a>
                            <span class="tw-font-semibold tw-text-[#939393]">|</span>
                            <a href="/seller-onboarding" class="tw-font-semibold tw-text-black tw-no-underline">Mulai Berjualan</a>
                            <span class="tw-font-semibold tw-text-[#939393]">|</span>
                            <a href="/unitrade/sponsorship" class="tw-font-semibold tw-text-black tw-no-underline">Sponsorship</a>
                        </div>
                        <div class="tw-flex tw-items-center tw-gap-[18px]">
                            <a href="/faq" class="tw-text-black tw-no-underline">FAQ</a>
                            <a href="/customer-service" class="tw-text-black tw-no-underline">Customer Service</a>
                            <a href="/contactus" class="tw-text-black tw-no-underline">Kontak</a>
                            <span class="tw-font-semibold tw-text-[#939393]">|</span>
                            <span>Ikuti kami :</span>
                            <span class="tw-flex tw-gap-2 tw-text-[12px]">
                                <i class="fa fa-instagram"></i>
                                <i class="fa fa-facebook-official"></i>
                                <i class="fa fa-music"></i>
                            </span>
                        </div>
                    </div>

                    <header class="ut-dash-navbar tw-absolute tw-left-8 tw-right-8 tw-top-[46px] tw-flex tw-h-[70px] tw-items-center tw-rounded-[54px] tw-bg-white tw-px-[14px] tw-shadow-[0_6px_8.95px_rgba(0,0,0,0.05)]">
                        <a href="/" class="tw-flex tw-h-[52px] tw-w-[129px] tw-items-center tw-gap-2 tw-rounded-full tw-px-[15px] tw-text-black tw-no-underline">
                            <img src="/unitrade_theme/static/src/img/logo-unitrade.png" alt="UniTrade" class="tw-h-[37px] tw-w-[41px] tw-object-contain"/>
                            <span class="tw-text-[12px] tw-font-bold">UniTrade</span>
                        </a>
                        <div class="tw-ml-[25px] tw-flex tw-h-12 tw-flex-1 tw-max-w-[658px] tw-items-center tw-rounded-[22.5px] tw-bg-[#f9f9f9] tw-pl-8 tw-pr-[5px]">
                            <input type="search" class="tw-min-w-0 tw-flex-1 tw-border-0 tw-bg-transparent tw-text-[12px] tw-text-[#212529] tw-outline-none placeholder:tw-text-[#939393]" placeholder="Cari produk di UniTrade"/>
                            <button type="button" class="tw-flex tw-size-[38px] tw-items-center tw-justify-center tw-rounded-full tw-border-0 tw-bg-[#212529] tw-text-white" aria-label="Cari produk">
                                <i class="fa fa-search"></i>
                            </button>
                        </div>
                        <div class="tw-ml-auto tw-flex tw-items-center tw-gap-[25px]">
                            <a href="/unitrade/seller/chat" class="ut-dash-nav-round tw-relative" aria-label="Chat Pembeli">
                                <i class="fa fa-commenting-o"></i>
                                <t t-if="stats.unread_chat_count">
                                    <span class="ut-dash-navbar-dot" t-esc="stats.unread_chat_count"></span>
                                </t>
                            </a>
                            <a href="/shop/cart" class="ut-dash-nav-round" aria-label="Keranjang">
                                <i class="fa fa-shopping-cart"></i>
                            </a>
                            <a href="/unitrade/seller/orders" class="ut-dash-nav-round tw-relative" aria-label="Notifikasi pesanan">
                                <i class="fa fa-bell-o"></i>
                                <t t-if="stats.notification_count">
                                    <span class="ut-dash-navbar-dot" t-esc="stats.notification_count"></span>
                                </t>
                            </a>
                            <span class="tw-h-[38.5px] tw-w-px tw-bg-[#e5e7eb]"></span>
                            <a href="/unitrade/seller/dashboard" class="ut-dash-nav-round" aria-label="Dashboard seller">
                                <i class="fa fa-truck"></i>
                            </a>
                            <img t-att-src="seller.avatar_url" alt="Avatar penjual" class="tw-size-[45px] tw-rounded-full tw-object-cover"/>
                            <span class="tw-mr-5 tw-max-w-[150px] tw-overflow-hidden tw-text-ellipsis tw-whitespace-nowrap tw-text-[16px] tw-font-medium tw-leading-6 tw-text-[#212529]" t-esc="seller.name"></span>
                        </div>
                        <button type="button" class="ut-dash-mobile-menu tw-hidden tw-border-0 tw-bg-transparent tw-text-[24px]" t-on-click="toggleSidebar" aria-label="Buka navigasi">
                            <i class="fa fa-bars"></i>
                        </button>
                    </header>

                    <div class="ut-dash-mobile-scrim" t-on-click="closeSidebar"></div>
                    <t t-call="unitrade_seller.SellerSidebar"/>

                    <main class="ut-refunds-main tw-absolute tw-left-[180px] tw-right-[67px] tw-top-[173px] tw-pb-10">
                        <section class="tw-mb-[38px]">
                            <h1 class="tw-m-0 tw-text-[40px] tw-font-normal tw-leading-none tw-text-black">Refund</h1>
                            <p class="tw-m-0 tw-mt-[7px] tw-text-[16px] tw-leading-6 tw-text-[#6a7282]">Berikut adalah hal-hal yang terjadi di toko Anda hari ini.</p>
                        </section>

                        <section class="ut-refunds-panel">
                            <div class="ut-refunds-panel-head">
                                <div class="ut-refunds-toolbar">
                                    <label class="ut-refunds-search">
                                        <i class="fa fa-search"></i>
                                        <input t-model="state.query" t-on-input="onSearchInput" t-on-keydown="onSearchKeydown" type="search" placeholder="Cari pesanan..."/>
                                    </label>
                                    <button type="button" t-att-class="state.filterOpen ? 'ut-refunds-filter-btn is-open' : 'ut-refunds-filter-btn'" t-on-click="toggleFilter">
                                        <i class="fa fa-filter"></i>
                                        <span>Filter</span>
                                    </button>
                                </div>
                                <div t-if="state.filterOpen" class="ut-refunds-filter-panel">
                                    <label>
                                        <span>Status</span>
                                        <select t-model="state.filterStatus">
                                            <t t-foreach="tabs" t-as="tab" t-key="tab.key">
                                                <option t-att-value="tab.key" t-esc="tab.label"></option>
                                            </t>
                                        </select>
                                    </label>
                                    <label>
                                        <span>Dari Tanggal</span>
                                        <input t-model="state.dateFrom" type="date"/>
                                    </label>
                                    <label>
                                        <span>Sampai Tanggal</span>
                                        <input t-model="state.dateTo" type="date"/>
                                    </label>
                                    <div class="ut-refunds-filter-actions">
                                        <button type="button" class="ut-refunds-filter-reset" t-on-click="clearFilters">Reset</button>
                                        <button type="button" class="ut-refunds-filter-apply" t-on-click="applyFilters">Terapkan</button>
                                    </div>
                                </div>
                                <div class="ut-refunds-tabs">
                                    <t t-foreach="tabs" t-as="tab" t-key="tab.key">
                                        <button type="button" t-att-class="tabClass(tab.key)" t-on-click="() => this.setTab(tab.key)">
                                            <span t-esc="tab.label"></span>
                                            <span class="ut-refunds-tab-count" t-esc="count(tab.key)"></span>
                                        </button>
                                    </t>
                                </div>
                            </div>

                            <div class="ut-refunds-table-wrap">
                                <div t-if="state.error" class="tw-m-6 tw-rounded-[16px] tw-border tw-border-red-200 tw-bg-red-50 tw-px-5 tw-py-4 tw-text-[14px] tw-font-semibold tw-text-red-700" t-esc="state.error"></div>
                                <div t-elif="refunds.length" class="tw-overflow-x-auto">
                                    <table class="ut-refunds-table tw-w-full tw-min-w-[1080px]">
                                        <thead>
                                            <tr>
                                                <th>Order ID</th>
                                                <th>Pelanggan</th>
                                                <th>Produk</th>
                                                <th>Total Harga</th>
                                                <th>Status</th>
                                                <th>Tanggal</th>
                                                <th>Aksi</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="refunds" t-as="refund" t-key="refund.key">
                                                <tr t-att-class="refundRowClass(refund)" t-on-click="(ev) => this.openRefundDetail(refund, ev)" t-on-keydown="(ev) => this.onRefundRowKeydown(refund, ev)" t-att-tabindex="refund.detail_url ? 0 : -1" role="link" t-att-aria-label="'Lihat detail refund ' + (refund.order_name || '')">
                                                    <td>
                                                        <strong class="tw-block tw-max-w-[96px] tw-whitespace-normal tw-text-[14px] tw-font-semibold tw-leading-5 tw-text-[#101828]" t-esc="refund.order_name"></strong>
                                                    </td>
                                                    <td>
                                                        <span class="tw-flex tw-items-center tw-gap-3">
                                                            <t t-if="refund.customer_avatar_url">
                                                                <img t-att-src="refund.customer_avatar_url" alt="" class="ut-customer-avatar ut-customer-avatar-sm"/>
                                                            </t>
                                                            <t t-else="">
                                                                <span class="ut-customer-avatar ut-customer-avatar-sm is-initials" t-esc="refund.customer_initials || 'UT'"></span>
                                                            </t>
                                                            <span class="tw-max-w-[130px] tw-whitespace-normal tw-text-[14px] tw-font-medium tw-leading-5 tw-text-[#101828]" t-esc="refund.customer_name"></span>
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <span class="tw-flex tw-items-center tw-gap-3">
                                                            <img t-att-src="refund.product_image_url || '/web/static/img/placeholder.png'" alt="" class="tw-size-12 tw-rounded-[10px] tw-border tw-border-[#e5e7eb] tw-object-cover" onerror="this.src='/web/static/img/placeholder.png'"/>
                                                            <span class="tw-min-w-0">
                                                                <strong class="tw-block tw-max-w-[180px] tw-overflow-hidden tw-text-ellipsis tw-whitespace-nowrap tw-text-[14px] tw-font-medium tw-leading-5 tw-text-[#101828]" t-esc="refund.product_name"></strong>
                                                                <span class="tw-block tw-text-[12px] tw-leading-4 tw-text-[#6a7282]">Qty: <t t-esc="refund.product_qty"/></span>
                                                            </span>
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <strong class="ut-refunds-total" t-esc="refund.total_label"></strong>
                                                    </td>
                                                    <td>
                                                        <span t-att-class="statusClass(refund.status_key)" t-esc="refund.status_label"></span>
                                                    </td>
                                                    <td>
                                                        <span class="tw-text-[14px] tw-leading-5 tw-text-[#6a7282]" t-esc="refund.date_label"></span>
                                                    </td>
                                                    <td>
                                                        <span class="ut-refunds-action-row" data-ut-refunds-no-row-click="true">
                                                            <a t-att-href="refund.detail_url" class="ut-refunds-action" aria-label="Lihat detail pengembalian">
                                                                <i class="fa fa-eye"></i>
                                                            </a>
                                                        </span>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                    <div class="ut-refunds-pagination">
                                        <span class="ut-refunds-pagination-info" t-esc="totalRefundsLabel"></span>
                                        <div class="ut-refunds-page-nav" aria-label="Navigasi halaman refund">
                                            <button type="button" class="ut-refunds-page-btn is-text" t-on-click="prevPage" t-att-disabled="(!pagination.has_prev || state.loading) ? true : undefined">Sebelumnya</button>
                                            <t t-foreach="pageNumbers" t-as="page" t-key="page">
                                                <button type="button" t-att-class="pageButtonClass(page)" t-on-click="() => this.goToPage(page)" t-att-disabled="state.loading ? true : undefined" t-esc="page"></button>
                                            </t>
                                            <button type="button" class="ut-refunds-page-btn is-text" t-on-click="nextPage" t-att-disabled="(!pagination.has_next || state.loading) ? true : undefined">Selanjutnya</button>
                                        </div>
                                    </div>
                                </div>
                                <div t-else="" class="tw-m-6 tw-rounded-[18px] tw-border tw-border-dashed tw-border-[#d8dce4] tw-bg-[#fbfbfc] tw-p-8 tw-text-center tw-text-[14px] tw-font-semibold tw-text-[#6a7282]">
                                    <t t-if="state.query">Refund tidak ditemukan untuk pencarian ini.</t>
                                    <t t-elif="hasDateFilter">Tidak ada refund pada rentang tanggal ini.</t>
                                    <t t-else="">Belum ada refund pada status ini.</t>
                                </div>
                            </div>
                        </section>
                    </main>
                </div>
            </t>
        </div>
    </t>

    <t t-name="unitrade_seller.SellerRefundsSkeleton">
        <div class="ut-dash-stage ut-refunds-stage ut-dash-skeleton-stage">
            <div class="ut-dash-promo tw-flex tw-items-center tw-justify-between tw-bg-white tw-px-[57px]">
                <span class="ut-dash-skeleton-line tw-w-[280px]"></span>
                <span class="ut-dash-skeleton-line tw-w-[210px]"></span>
            </div>
            <header class="ut-dash-navbar tw-absolute tw-left-8 tw-right-8 tw-top-[46px] tw-flex tw-h-[70px] tw-items-center tw-rounded-[54px] tw-bg-white tw-px-[14px] tw-shadow-[0_6px_8.95px_rgba(0,0,0,0.05)]">
                <span class="ut-dash-skeleton-circle tw-size-[41px]"></span>
                <span class="ut-dash-skeleton-line tw-ml-3 tw-w-[74px]"></span>
                <span class="ut-dash-skeleton-block tw-ml-[55px] tw-h-12 tw-flex-1 tw-max-w-[658px] tw-rounded-[22px]"></span>
                <span class="ut-dash-skeleton-circle tw-ml-auto tw-size-[38px]"></span>
                <span class="ut-dash-skeleton-circle tw-size-[38px]"></span>
                <span class="ut-dash-skeleton-circle tw-size-[38px]"></span>
                <span class="ut-dash-skeleton-circle tw-size-[45px]"></span>
                <span class="ut-dash-skeleton-line tw-w-[116px]"></span>
            </header>
            <aside class="ut-dash-sidebar ut-refunds-sidebar ut-dash-skeleton-sidebar">
                <div class="ut-dash-sidebar-brand">
                    <span class="ut-dash-skeleton-block tw-size-8 tw-rounded-[10px]"></span>
                </div>
                <div class="ut-dash-sidebar-nav">
                    <span class="ut-dash-skeleton-block tw-h-10 tw-w-[52px] tw-rounded-[14px]"></span>
                    <span class="ut-dash-skeleton-block tw-h-10 tw-w-[52px] tw-rounded-[14px]"></span>
                    <span class="ut-dash-skeleton-block tw-h-10 tw-w-[52px] tw-rounded-[14px]"></span>
                    <span class="ut-dash-skeleton-block tw-h-10 tw-w-[52px] tw-rounded-[14px]"></span>
                    <span class="ut-dash-skeleton-block tw-h-10 tw-w-[52px] tw-rounded-[14px]"></span>
                    <span class="ut-dash-skeleton-block tw-h-10 tw-w-[52px] tw-rounded-[14px]"></span>
                </div>
                <div class="ut-dash-sidebar-footer">
                    <span class="ut-dash-skeleton-block tw-h-10 tw-w-[52px] tw-rounded-[14px]"></span>
                    <span class="ut-dash-skeleton-block tw-h-10 tw-w-[52px] tw-rounded-[14px]"></span>
                </div>
            </aside>
            <main class="ut-refunds-main tw-absolute tw-left-[180px] tw-right-[67px] tw-top-[173px] tw-pb-10">
                <section class="tw-mb-[38px]">
                    <span class="ut-dash-skeleton-line tw-h-11 tw-w-[160px] tw-rounded-[16px]"></span>
                    <span class="ut-dash-skeleton-line tw-mt-3 tw-h-5 tw-w-[430px]"></span>
                </section>
                <section class="ut-dash-skeleton-card tw-min-h-[720px] tw-rounded-[21px] tw-p-8">
                    <div class="tw-flex tw-gap-8">
                        <span class="ut-dash-skeleton-block tw-h-[46px] tw-flex-1 tw-rounded-[10px]"></span>
                        <span class="ut-dash-skeleton-block tw-h-[46px] tw-w-[90px] tw-rounded-[10px]"></span>
                    </div>
                    <div class="tw-mt-6 tw-flex tw-gap-9">
                        <span class="ut-dash-skeleton-line tw-h-5 tw-w-[140px]"></span>
                        <span class="ut-dash-skeleton-line tw-h-5 tw-w-[70px]"></span>
                        <span class="ut-dash-skeleton-line tw-h-5 tw-w-[80px]"></span>
                        <span class="ut-dash-skeleton-line tw-h-5 tw-w-[100px]"></span>
                        <span class="ut-dash-skeleton-line tw-h-5 tw-w-[80px]"></span>
                    </div>
                    <div class="tw-mt-14 tw-rounded-[16px] tw-border tw-border-[#e5e7eb] tw-bg-white tw-p-6">
                        <span class="ut-dash-skeleton-row"></span>
                        <span class="ut-dash-skeleton-row tw-mt-5"></span>
                        <span class="ut-dash-skeleton-row tw-mt-5"></span>
                        <span class="ut-dash-skeleton-row tw-mt-5"></span>
                        <span class="ut-dash-skeleton-row tw-mt-5"></span>
                        <span class="ut-dash-skeleton-row tw-mt-5"></span>
                    </div>
                </section>
            </main>
        </div>
    </t>
</templates>
