<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="unitrade_seller.SellerSettings">
        <div t-att-class="rootClass">
            <t t-if="!state.ready || state.loading">
                <t t-call="unitrade_seller.SellerSettingsSkeleton"/>
            </t>
            <t t-else="">
                <div class="ut-dash-stage ut-settings-stage">
                    <div class="ut-dash-promo tw-flex tw-items-center tw-justify-between tw-bg-white tw-px-[57px] tw-text-[12px] tw-leading-6 tw-text-black">
                        <div class="tw-flex tw-items-center tw-gap-[18px]">
                            <span>Gratis Ongkir + Diskon 30%</span>
                            <a href="/shop" class="tw-font-semibold tw-text-black tw-no-underline">Belanja Sekarang +</a>
                            <span class="tw-font-semibold tw-text-[#939393]">|</span>
                            <a href="/seller-onboarding" class="tw-font-semibold tw-text-black tw-no-underline">Mulai Berjualan</a>
                        </div>
                        <div class="tw-flex tw-items-center tw-gap-[18px]">
                            <a href="/help" class="tw-text-black tw-no-underline">Bantuan</a>
                            <a href="/contactus" class="tw-text-black tw-no-underline">Kontak</a>
                            <span class="tw-font-semibold tw-text-[#939393]">|</span>
                            <span>Ikuti kami :</span>
                            <span class="tw-flex tw-gap-2 tw-text-[12px]">
                                <i class="fa fa-instagram"></i>
                                <i class="fa fa-facebook-official"></i>
                                <i class="fa fa-music"></i>
                            </span>
                        </div>
                    </div>

                    <header class="ut-dash-navbar tw-absolute tw-left-8 tw-right-8 tw-top-[46px] tw-flex tw-h-[70px] tw-items-center tw-rounded-[54px] tw-bg-white tw-px-[14px] tw-shadow-[0_6px_8.95px_rgba(0,0,0,0.05)]">
                        <a href="/" class="tw-flex tw-h-[52px] tw-w-[129px] tw-items-center tw-gap-2 tw-rounded-full tw-px-[15px] tw-text-black tw-no-underline">
                            <img src="/unitrade_theme/static/src/img/logo-unitrade.png" alt="UniTrade" class="tw-h-[37px] tw-w-[41px] tw-object-contain"/>
                            <span class="tw-text-[12px] tw-font-bold">UniTrade</span>
                        </a>
                        <div class="tw-ml-[25px] tw-flex tw-h-12 tw-flex-1 tw-max-w-[658px] tw-items-center tw-rounded-[22.5px] tw-bg-[#f9f9f9] tw-pl-8 tw-pr-[5px]">
                            <input type="search" class="tw-min-w-0 tw-flex-1 tw-border-0 tw-bg-transparent tw-text-[12px] tw-text-[#212529] tw-outline-none placeholder:tw-text-[#939393]" placeholder="Cari produk di UniTrade"/>
                            <button type="button" class="tw-flex tw-size-[38px] tw-items-center tw-justify-center tw-rounded-full tw-border-0 tw-bg-[#212529] tw-text-white" aria-label="Cari produk">
                                <i class="fa fa-search"></i>
                            </button>
                        </div>
                        <div class="tw-ml-auto tw-flex tw-items-center tw-gap-[25px]">
                            <a href="/unitrade/seller/chat" class="ut-dash-nav-round tw-relative" aria-label="Chat Pembeli">
                                <i class="fa fa-commenting-o"></i>
                                <t t-if="stats.unread_chat_count">
                                    <span class="ut-dash-navbar-dot" t-esc="stats.unread_chat_count"></span>
                                </t>
                            </a>
                            <a href="/shop/cart" class="ut-dash-nav-round" aria-label="Keranjang">
                                <i class="fa fa-shopping-cart"></i>
                            </a>
                            <a href="/unitrade/seller/orders" class="ut-dash-nav-round tw-relative" aria-label="Notifikasi">
                                <i class="fa fa-bell-o"></i>
                                <t t-if="stats.notification_count">
                                    <span class="ut-dash-navbar-dot" t-esc="stats.notification_count"></span>
                                </t>
                            </a>
                            <span class="tw-h-[38.5px] tw-w-px tw-bg-[#e5e7eb]"></span>
                            <a href="/unitrade/seller/dashboard" class="ut-dash-nav-round" aria-label="Dashboard seller">
                                <i class="fa fa-truck"></i>
                            </a>
                            <img t-att-src="seller.avatar_url" alt="Avatar penjual" class="tw-size-[45px] tw-rounded-full tw-object-cover"/>
                            <span class="tw-mr-5 tw-max-w-[150px] tw-overflow-hidden tw-text-ellipsis tw-whitespace-nowrap tw-text-[16px] tw-font-medium tw-leading-6 tw-text-[#212529]" t-esc="seller.name"></span>
                        </div>
                        <button type="button" class="ut-dash-mobile-menu tw-hidden tw-border-0 tw-bg-transparent tw-text-[24px]" t-on-click="toggleSidebar" aria-label="Buka navigasi">
                            <i class="fa fa-bars"></i>
                        </button>
                    </header>

                    <div class="ut-dash-mobile-scrim" t-on-click="closeSidebar"></div>
                    <t t-call="unitrade_seller.SellerSidebar"/>

                    <main class="ut-settings-main tw-absolute tw-left-[181px] tw-top-[173px] tw-w-[859px] tw-pb-16">
                        <section class="tw-mb-[24px]">
                            <h1 class="tw-m-0 tw-text-[40px] tw-font-normal tw-leading-none tw-text-black">Pengaturan Toko</h1>
                            <p class="tw-m-0 tw-mt-[7px] tw-text-[16px] tw-leading-6 tw-text-[#6a7282]">Kelola informasi toko, logistik, dan rekening pencairan</p>
                        </section>

                        <div t-if="state.error" class="ut-product-create-alert is-error" t-esc="state.error"></div>
                        <div t-if="state.success" class="ut-product-create-alert is-success" t-esc="state.success"></div>

                        <section class="ut-settings-card tw-mb-6">
                            <header class="ut-settings-card-head">
                                <span class="ut-settings-card-icon is-blue"><i class="fa fa-id-card-o"></i></span>
                                <span>
                                    <h2>Informasi Publik Toko</h2>
                                    <p>Informasi yang terlihat oleh pembeli</p>
                                </span>
                                <label class="ut-settings-switch">
                                    <input type="checkbox" t-att-checked="state.form.storeActive ? true : undefined" t-on-change="setStoreActive"/>
                                    <span></span>
                                    <strong t-esc="state.form.storeActive ? 'Aktif' : 'Nonaktif'"></strong>
                                </label>
                            </header>
                            <div class="ut-settings-fields">
                                <div class="ut-settings-field">
                                    <label>Tautan Toko</label>
                                    <div class="ut-settings-url-row">
                                        <span class="ut-settings-url-prefix" t-esc="state.form.storeUrlBase"></span>
                                        <input type="text" t-att-value="state.form.slug" t-on-input="(ev) => this.setField('slug', ev)" placeholder="nama-toko"/>
                                        <a t-att-href="seller.profile_url" class="ut-settings-icon-link" target="_blank" aria-label="Buka profil toko">
                                            <i class="fa fa-external-link"></i>
                                        </a>
                                    </div>
                                </div>
                                <div class="ut-settings-field">
                                    <label>Deskripsi / Catatan Toko</label>
                                    <textarea t-att-value="state.form.description" t-on-input="(ev) => this.setField('description', ev)" placeholder="Tuliskan jam operasional, kebijakan retur, atau sapaan pembeli"></textarea>
                                </div>
                                <div class="ut-settings-actions">
                                    <button type="button" class="ut-settings-save" t-att-disabled="state.savingSection ? true : undefined" t-on-click="() => this.saveSection('public')">
                                        <i t-att-class="state.savingSection === 'public' ? 'fa fa-spinner fa-spin' : 'fa fa-floppy-o'"></i>
                                        <span t-esc="state.savingSection === 'public' ? 'Menyimpan...' : 'Simpan Perubahan'"></span>
                                    </button>
                                </div>
                            </div>
                        </section>

                        <section class="ut-settings-card tw-mb-6">
                            <header class="ut-settings-card-head">
                                <span class="ut-settings-card-icon is-green"><i class="fa fa-map-marker"></i></span>
                                <span>
                                    <h2>Alamat &amp; Logistik</h2>
                                    <p>Alamat gudang dan pengaturan pengiriman</p>
                                </span>
                            </header>
                            <div class="ut-settings-fields">
                                <div class="ut-settings-two-grid">
                                    <div class="ut-settings-field">
                                        <label>Provinsi</label>
                                        <input type="text" t-att-value="state.form.province" t-on-input="(ev) => this.setField('province', ev)" placeholder="DI Yogyakarta"/>
                                    </div>
                                    <div class="ut-settings-field">
                                        <label>Kota / Kabupaten</label>
                                        <input type="text" t-att-value="state.form.city" t-on-input="(ev) => this.setField('city', ev)" placeholder="Sleman"/>
                                    </div>
                                </div>
                                <div class="ut-settings-field">
                                    <label>Detail Alamat</label>
                                    <div class="ut-settings-address-wrap">
                                        <i class="fa fa-map-marker"></i>
                                        <textarea t-att-value="state.form.addressDetail" t-on-input="(ev) => this.setField('addressDetail', ev)" placeholder="Nama jalan, nomor rumah, RT/RW, kelurahan, kecamatan"></textarea>
                                    </div>
                                </div>
                                <div class="ut-settings-actions">
                                    <button type="button" class="ut-settings-save" t-att-disabled="state.savingSection ? true : undefined" t-on-click="() => this.saveSection('logistic')">
                                        <i t-att-class="state.savingSection === 'logistic' ? 'fa fa-spinner fa-spin' : 'fa fa-floppy-o'"></i>
                                        <span t-esc="state.savingSection === 'logistic' ? 'Menyimpan...' : 'Simpan Perubahan'"></span>
                                    </button>
                                </div>
                            </div>
                        </section>

                        <section class="ut-settings-card tw-mb-6">
                            <header class="ut-settings-card-head">
                                <span class="ut-settings-card-icon is-purple"><i class="fa fa-credit-card"></i></span>
                                <span>
                                    <h2>Rekening Pencairan</h2>
                                    <p>Informasi rekening untuk pencairan dana</p>
                                </span>
                            </header>
                            <div class="ut-settings-fields">
                                <div class="ut-settings-field">
                                    <label>Nama Bank</label>
                                    <select t-att-value="state.form.bankName" t-on-change="(ev) => this.setField('bankName', ev)">
                                        <t t-foreach="state.bankOptions" t-as="bank" t-key="bank.value">
                                            <option t-att-value="bank.value" t-att-selected="state.form.bankName === bank.value ? true : undefined" t-esc="bank.label"></option>
                                        </t>
                                    </select>
                                </div>
                                <div class="ut-settings-field">
                                    <label>Nomor Rekening</label>
                                    <input type="text" inputmode="numeric" t-att-value="state.form.accountNumber" t-on-input="(ev) => this.setField('accountNumber', ev)" placeholder="1234567890"/>
                                </div>
                                <div class="ut-settings-field">
                                    <label>Nama Pemilik Rekening</label>
                                    <input type="text" t-att-value="state.form.accountName" t-on-input="(ev) => this.setField('accountName', ev)" placeholder="Sesuai dengan KTP"/>
                                </div>
                                <div class="ut-settings-actions">
                                    <button type="button" class="ut-settings-save" t-att-disabled="state.savingSection ? true : undefined" t-on-click="() => this.saveSection('payout')">
                                        <i t-att-class="state.savingSection === 'payout' ? 'fa fa-spinner fa-spin' : 'fa fa-floppy-o'"></i>
                                        <span t-esc="state.savingSection === 'payout' ? 'Menyimpan...' : 'Simpan Perubahan'"></span>
                                    </button>
                                </div>
                            </div>
                        </section>

                        <section class="ut-settings-card ut-settings-danger">
                            <header class="ut-settings-danger-head">
                                <i class="fa fa-exclamation-triangle"></i>
                                <h2>Danger Zone</h2>
                            </header>
                            <p>Menutup toko akan menonaktifkan seluruh produk dan menghentikan transaksi aktif.</p>
                            <div class="ut-settings-danger-actions">
                                <button type="button" class="ut-settings-close-store" t-att-disabled="state.closing ? true : undefined" t-on-click="closeStore">
                                    <span t-esc="state.closing ? 'Menutup Toko...' : 'Tutup Toko'"></span>
                                </button>
                                <button type="button" class="ut-settings-request-delete" t-att-disabled="state.requestingDelete || state.form.deleteRequested ? true : undefined" t-on-click="requestDeleteSeller">
                                    <span t-esc="state.form.deleteRequested ? 'Permintaan Hapus Akun Tercatat' : (state.requestingDelete ? 'Memproses...' : 'Hapus Akun Penjual')"></span>
                                </button>
                            </div>
                        </section>
                    </main>
                </div>
            </t>
        </div>
    </t>

    <t t-name="unitrade_seller.SellerSettingsSkeleton">
        <div class="ut-dash-stage ut-settings-stage ut-dash-skeleton-stage">
            <div class="ut-dash-promo tw-flex tw-items-center tw-justify-between tw-bg-white tw-px-[57px]">
                <span class="ut-dash-skeleton-line tw-w-[280px]"></span>
                <span class="ut-dash-skeleton-line tw-w-[210px]"></span>
            </div>
            <header class="ut-dash-navbar tw-absolute tw-left-8 tw-right-8 tw-top-[46px] tw-flex tw-h-[70px] tw-items-center tw-rounded-[54px] tw-bg-white tw-px-[14px] tw-shadow-[0_6px_8.95px_rgba(0,0,0,0.05)]">
                <span class="ut-dash-skeleton-circle tw-size-[41px]"></span>
                <span class="ut-dash-skeleton-line tw-ml-3 tw-w-[74px]"></span>
                <span class="ut-dash-skeleton-block tw-ml-[55px] tw-h-12 tw-flex-1 tw-max-w-[658px] tw-rounded-[22px]"></span>
                <span class="ut-dash-skeleton-circle tw-ml-auto tw-size-[38px]"></span>
                <span class="ut-dash-skeleton-circle tw-size-[38px]"></span>
                <span class="ut-dash-skeleton-circle tw-size-[38px]"></span>
                <span class="ut-dash-skeleton-circle tw-size-[45px]"></span>
                <span class="ut-dash-skeleton-line tw-w-[116px]"></span>
            </header>
            <aside class="ut-dash-sidebar ut-seller-shared-sidebar ut-settings-sidebar ut-dash-skeleton-sidebar">
                <div class="ut-dash-sidebar-brand">
                    <span class="ut-dash-skeleton-block tw-size-8 tw-rounded-[10px]"></span>
                </div>
                <div class="ut-dash-sidebar-nav">
                    <span class="ut-dash-skeleton-block tw-h-10 tw-w-[52px] tw-rounded-[14px]"></span>
                    <span class="ut-dash-skeleton-block tw-h-10 tw-w-[52px] tw-rounded-[14px]"></span>
                    <span class="ut-dash-skeleton-block tw-h-10 tw-w-[52px] tw-rounded-[14px]"></span>
                    <span class="ut-dash-skeleton-block tw-h-10 tw-w-[52px] tw-rounded-[14px]"></span>
                    <span class="ut-dash-skeleton-block tw-h-10 tw-w-[52px] tw-rounded-[14px]"></span>
                    <span class="ut-dash-skeleton-block tw-h-10 tw-w-[52px] tw-rounded-[14px]"></span>
                    <span class="ut-dash-skeleton-block tw-h-10 tw-w-[52px] tw-rounded-[14px]"></span>
                </div>
                <div class="ut-dash-sidebar-footer">
                    <span class="ut-dash-skeleton-block tw-h-10 tw-w-[52px] tw-rounded-[14px]"></span>
                </div>
            </aside>
            <main class="ut-settings-main tw-absolute tw-left-[181px] tw-top-[173px] tw-w-[859px] tw-pb-16">
                <section class="tw-mb-[24px]">
                    <span class="ut-dash-skeleton-line tw-h-11 tw-w-[320px] tw-rounded-[16px]"></span>
                    <span class="ut-dash-skeleton-line tw-mt-3 tw-h-5 tw-w-[520px]"></span>
                </section>
                <span class="ut-dash-skeleton-card tw-mb-6 tw-h-[462px] tw-w-full"></span>
                <span class="ut-dash-skeleton-card tw-mb-6 tw-h-[425px] tw-w-full"></span>
                <span class="ut-dash-skeleton-card tw-mb-6 tw-h-[454px] tw-w-full"></span>
                <span class="ut-dash-skeleton-card tw-h-[250px] tw-w-full"></span>
            </main>
        </div>
    </t>
</templates>
