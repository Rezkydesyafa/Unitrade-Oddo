<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="ir_cron_unitrade_auto_confirm_buyer_receipt" model="ir.cron">
        <field name="name">UniTrade Auto Confirm Buyer Receipt</field>
        <field name="model_id" ref="model_unitrade_escrow_ledger"/>
        <field name="state">code</field>
        <field name="code">model.cron_auto_confirm_buyer_receipt()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_unitrade_process_requested_payouts" model="ir.cron">
        <field name="name">UniTrade Process Requested Seller Payouts</field>
        <field name="model_id" ref="unitrade_seller.model_unitrade_seller_payout"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="state">code</field>
        <field name="code">model.cron_process_requested_payouts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>
</odoo>
