<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="product_catalog_template" name="UniTrade Product Catalog">
        <t t-call="website.layout">
            <t t-set="title" t-value="page_title"/>
            <div class="tw-max-w-7xl tw-mx-auto tw-px-4 tw-py-8">
                <h1 class="unitrade-section-title tw-mb-2" t-esc="catalog_heading or 'Katalog Produk'">Katalog Produk</h1>
                <p t-if="selected_category" class="tw-mb-8 tw-text-sm tw-text-gray-500">
                    Kategori: <strong class="tw-text-gray-900" t-esc="catalog_category_label or selected_category.name"/>
                </p>
                <p t-else="" class="tw-mb-8 tw-text-sm tw-text-gray-500">Temukan barang dari semua kategori UniTrade.</p>
                <t t-if="category_banner">
                    <section class="tw-relative tw-w-full tw-overflow-hidden tw-bg-gray-100 tw-shadow-sm" t-att-style="'margin-top: 28px; margin-bottom: 36px; height: clamp(190px, 24vw, 340px); border-radius: 28px; background-image: url(%s); background-size: cover; background-position: center; box-shadow: 0 14px 34px rgba(15, 23, 42, 0.08);' % category_banner.get('image')" aria-label="Banner kategori produk">
                        <div class="tw-absolute tw-inset-0" style="background: linear-gradient(90deg, rgba(255,255,255,0.96) 0%, rgba(255,255,255,0.84) 38%, rgba(255,255,255,0.24) 68%, rgba(255,255,255,0) 100%);"></div>
                        <div class="tw-relative tw-z-10 tw-flex tw-h-full tw-flex-col tw-items-start tw-justify-center" style="max-width: 500px; padding-left: clamp(22px, 3.5vw, 42px); padding-right: 22px;">
                            <h2 class="tw-m-0 tw-font-bold tw-text-gray-900" style="font-size: clamp(24px, 3.2vw, 42px); line-height: 1.08; letter-spacing: 0;">
                                <t t-esc="category_banner.get('title')"/>
                            </h2>
                            <p class="tw-m-0 tw-mt-3 tw-text-sm tw-font-medium tw-leading-6 tw-text-gray-700" style="max-width: 400px; font-size: clamp(13px, 1.25vw, 16px);">
                                <t t-esc="category_banner.get('subtitle')"/>
                            </p>
                            <a t-att-href="category_banner.get('cta_url')" class="tw-mt-4 tw-inline-flex tw-items-center tw-rounded-full tw-bg-black tw-px-4 tw-py-2 tw-text-xs tw-font-semibold tw-text-white tw-no-underline tw-transition-colors hover:tw-bg-black">
                                <t t-esc="category_banner.get('cta')"/>
                            </a>
                        </div>
                    </section>
                </t>
                <t t-if="products">
                    <div id="unitrade-product-grid" class="ut-product-card-grid tw-grid tw-mb-8 tw-w-full">
                        <t t-foreach="products" t-as="product">
                            <div class="oe_product tw-h-full">
                                <t t-set="ut_card_href" t-value="product.website_url or '/unitrade/product/%s' % product.id"/>
                                <t t-set="ut_card_product" t-value="product"/>
                                <t t-set="ut_card_class" t-value="'tw-bg-white tw-border tw-border-solid tw-border-gray-200 tw-rounded-[14px] tw-overflow-hidden tw-shadow-sm hover:tw-shadow-md hover:-tw-translate-y-1 tw-transition-all tw-duration-300 tw-flex tw-flex-col tw-h-full tw-no-underline tw-group'"/>
                                <t t-call="unitrade_theme.unitrade_product_card"/>
                            </div>
                        </t>
                    </div>
                </t>
                <div t-else="" id="unitrade-product-grid" class="tw-flex tw-min-h-[320px] tw-flex-col tw-items-center tw-justify-center tw-rounded-[24px] tw-border tw-border-solid tw-border-gray-200 tw-bg-white tw-p-8 tw-text-center tw-shadow-sm">
                    <i class="fa fa-search tw-mb-4 tw-text-4xl tw-text-gray-300"></i>
                    <h2 class="tw-m-0 tw-text-xl tw-font-semibold tw-text-gray-900">Belum ada produk di kategori ini</h2>
                    <p class="tw-m-0 tw-mt-2 tw-max-w-md tw-text-sm tw-leading-6 tw-text-gray-500">Coba pilih kategori lain atau gunakan kata kunci pencarian yang lebih umum.</p>
                    <a href="/shop" class="tw-mt-5 tw-inline-flex tw-items-center tw-rounded-full tw-bg-black tw-px-5 tw-py-2.5 tw-text-sm tw-font-semibold tw-text-white tw-no-underline">Lihat semua produk</a>
                </div>
            </div>
        </t>
    </template>

    <template id="product_detail_template" name="UniTrade Product Detail">
        <t t-call="website.layout">
            <t t-set="title" t-value="product.name"/>
            <div class="tw-max-w-7xl tw-mx-auto tw-px-4 tw-py-8">
                <div class="tw-grid tw-grid-cols-1 md:tw-grid-cols-2 tw-gap-10">
                    <div class="tw-aspect-square tw-bg-gray-100 tw-rounded-2xl tw-overflow-hidden">
                        <img t-att-src="'/web/image/product.template/%s/image_1920' % product.id" t-att-alt="product.name" class="tw-w-full tw-h-full tw-object-cover"/>
                    </div>
                    <div>
                        <t t-set="ut_price_info" t-value="product._unitrade_price_info()"/>
                        <h1 class="tw-text-3xl tw-font-bold tw-text-gray-900 tw-mb-4"><t t-esc="product.name"/></h1>
                        <div class="tw-mb-6 tw-flex tw-flex-wrap tw-items-baseline tw-gap-3">
                            <p class="tw-m-0 tw-text-3xl tw-font-bold tw-text-indigo-600">Rp <t t-esc="'{:,.0f}'.format(ut_price_info.get('discounted_price')).replace(',', '.')"/></p>
                        </div>
                        <div class="tw-flex tw-gap-3 tw-mb-6">
                            <t t-if="product.x_condition">
                                <span t-attf-class="unitrade-badge #{product.x_condition == 'new' and 'unitrade-badge-new' or 'unitrade-badge-used'}">
                                    <t t-if="product.x_condition == 'new'">Baru</t><t t-else="">Bekas</t>
                                </span>
                            </t>
                            <t t-if="product.x_seller_id and product.x_seller_id.status == 'verified'">
                                <span class="unitrade-badge unitrade-badge-verified">✓ Seller Verified</span>
                            </t>
                        </div>
                        <div class="tw-space-y-4 tw-mb-8">
                            <p class="tw-text-gray-600"><t t-raw="product.description_sale or 'Tidak ada deskripsi.'"/></p>
                            <p class="tw-text-sm tw-text-gray-500 tw-flex tw-items-center"><i class="fa fa-map-marker tw-mr-1"></i> <t t-esc="product.x_seller_location or 'Yogyakarta'"/></p>
                            <p class="tw-text-sm tw-text-gray-500">📦 Stok: <t t-esc="int(product.qty_available)"/> tersedia</p>
                        </div>
                        <div class="tw-flex tw-gap-4">
                            <a t-attf-href="/shop/cart/update?product_id=#{product.product_variant_id.id}&amp;add_qty=1" class="unitrade-btn-primary tw-flex-1 tw-text-center">🛒 Tambah Keranjang</a>
                            <button class="unitrade-btn-secondary">💬 Chat Penjual</button>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
