<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================================
             Record Rules: unitrade.notification
             ============================================================
             Users may only access their own notifications. Admins of the
             UniTrade marketplace bypass that restriction via a separate
             admin-only rule with a permissive domain. The admin group is
             intentionally NOT added to the user rule so that admins are
             not constrained by `user_id = user.id` (rules combine with
             OR across groups, AND across non-grouped rules).
             ============================================================ -->

        <record id="unitrade_notification_user_rule" model="ir.rule">
            <field name="name">Notification: own only</field>
            <field name="model_id" ref="model_unitrade_notification"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="unitrade_notification_portal_rule" model="ir.rule">
            <field name="name">Notification: portal own only</field>
            <field name="model_id" ref="model_unitrade_notification"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="unitrade_notification_admin_rule" model="ir.rule">
            <field name="name">Notification: admin full access</field>
            <field name="model_id" ref="model_unitrade_notification"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('unitrade_seller.group_unitrade_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ============================================================
             Record Rules: unitrade.notification.preference
             ============================================================
             Same isolation contract as notifications: each user only sees
             their own preference rows; admins see and manage everything.
             ============================================================ -->

        <record id="unitrade_notification_preference_user_rule" model="ir.rule">
            <field name="name">Notification Preference: own only</field>
            <field name="model_id" ref="model_unitrade_notification_preference"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="unitrade_notification_preference_portal_rule" model="ir.rule">
            <field name="name">Notification Preference: portal own only</field>
            <field name="model_id" ref="model_unitrade_notification_preference"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="unitrade_notification_preference_admin_rule" model="ir.rule">
            <field name="name">Notification Preference: admin full access</field>
            <field name="model_id" ref="model_unitrade_notification_preference"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('unitrade_seller.group_unitrade_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
