<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="unitrade_my_orders_refund_actions" inherit_id="unitrade_theme.unitrade_portal_my_orders" name="UniTrade My Orders Refund Actions">
        <xpath expr="//footer[hasclass('ut-user-order-actions')]/form[contains(@t-if, 'can_cancel_order')]" position="before">
            <a t-if="item.get('refund_detail_url')" t-att-href="item.get('refund_detail_url')" class="ut-user-order-btn ut-user-order-btn-outline">
                Lihat Refund
            </a>
            <button t-if="not item.get('refund_detail_url') and item.get('can_refund_order')" type="button"
                class="ut-user-order-btn ut-user-order-btn-danger"
                data-refund-open="1"
                t-att-data-refund-url="item.get('refund_url')"
                t-att-data-refund-ledger-id="item.get('ledger').id if item.get('ledger') else ''"
                t-att-data-refund-line-id="item.get('line').id if item.get('line') else ''"
                t-att-data-refund-product-name="item.get('product').name"
                t-att-data-refund-seller-name="item.get('seller_name')"
                t-att-data-refund-amount="item.get('refund_requested_amount')">
                Ajukan Refund
            </button>
        </xpath>

        <xpath expr="//div[hasclass('ut-order-review-modal')]" position="after">
            <div class="ut-order-refund-modal" data-order-refund-modal="1" aria-hidden="true">
                <div class="ut-order-refund-backdrop" data-refund-close="1"></div>
                <section class="ut-order-refund-dialog" role="dialog" aria-modal="true" aria-labelledby="ut_order_refund_title">
                    <header class="ut-order-refund-head">
                        <div>
                            <h2 id="ut_order_refund_title">Ajukan Refund</h2>
                            <p>Refund akan ditinjau UniTrade. Payout seller ditahan sampai keputusan final.</p>
                        </div>
                        <button type="button" class="ut-order-refund-close" data-refund-close="1" aria-label="Tutup">x</button>
                    </header>
                    <form action="/my/orders" method="post" enctype="multipart/form-data" class="ut-order-refund-form" data-refund-form="1">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="ledger_id" data-refund-ledger-id="1"/>
                        <input type="hidden" name="order_line_id" data-refund-line-id="1"/>

                        <article class="ut-order-refund-product">
                            <div>
                                <strong data-refund-product-name="1">Produk</strong>
                                <span data-refund-seller-name="1">Penjual UniTrade</span>
                            </div>
                            <small>Nominal: <b data-refund-amount="1">-</b></small>
                        </article>

                        <div class="ut-order-refund-field">
                            <label for="ut_refund_reason">Alasan refund</label>
                            <select id="ut_refund_reason" name="reason_code" required="required" data-refund-reason="1">
                                <option value="seller_no_handoff">Seller tidak menyerahkan barang</option>
                                <option value="not_as_described">Barang tidak sesuai deskripsi</option>
                                <option value="damaged">Barang rusak/tidak berfungsi</option>
                                <option value="wrong_item">Salah barang</option>
                                <option value="other">Lainnya</option>
                            </select>
                        </div>

                        <div class="ut-order-refund-field">
                            <label for="ut_refund_note">Catatan refund</label>
                            <textarea id="ut_refund_note" name="reason_note" minlength="20" required="required" placeholder="Jelaskan kronologi dan alasan refund minimal 20 karakter."></textarea>
                        </div>

                        <div class="ut-order-refund-field">
                            <span>Bukti foto/video</span>
                            <label class="ut-order-refund-upload">
                                <strong>Foto bukti</strong>
                                <input type="file" name="refund_evidence" accept="image/jpeg,image/png,image/webp,video/mp4,video/webm" required="required" multiple="multiple"/>
                                <small>Minimal satu bukti wajib. Maksimal mengikuti konfigurasi admin.</small>
                            </label>
                            <label class="ut-order-refund-upload">
                                <strong>Video unboxing</strong>
                                <input type="file" name="unboxing_video" accept="video/mp4,video/webm" data-refund-unboxing="1"/>
                                <small data-refund-unboxing-hint="1">Opsional, tetapi membantu proses review.</small>
                            </label>
                        </div>

                        <div class="ut-order-refund-field">
                            <label for="ut_refund_drive_url">Link Google Drive (opsional)</label>
                            <input id="ut_refund_drive_url" type="url" name="google_drive_url" placeholder="https://drive.google.com/..."/>
                            <small class="ut-order-refund-help">Gunakan link ini untuk file besar yang sulit diunggah langsung.</small>
                        </div>

                        <footer class="ut-order-refund-actions">
                            <button type="button" class="ut-order-refund-cancel" data-refund-close="1">Batal</button>
                            <button type="submit" class="ut-order-refund-submit">Kirim Refund</button>
                        </footer>
                    </form>
                </section>
            </div>
        </xpath>
    </template>

    <template id="unitrade_order_status_refund_panel" inherit_id="unitrade_payment.unitrade_order_status" name="UniTrade Order Status Refund Panel">
        <xpath expr="//section[@t-if='order_status_ledgers']" position="after">
            <section class="ut-order-status-card" t-if="order_status_refunds">
                <h2 class="ut-order-status-card-title">Refund</h2>
                <div t-foreach="order_status_refunds" t-as="refund" class="ut-order-status-ledger">
                    <div>
                        <strong t-esc="refund.get('name')"/>
                        <p class="ut-order-status-meta">
                            <t t-esc="refund.get('reason')"/> · <t t-esc="refund.get('requested_amount')"/>
                        </p>
                        <p t-if="refund.get('decision_note')" class="ut-order-status-meta" t-esc="refund.get('decision_note')"/>
                    </div>
                    <a t-att-href="refund.get('url')" class="ut-order-status-chip" t-esc="refund.get('state_label')"/>
                </div>
            </section>
        </xpath>
        <xpath expr="//div[hasclass('ut-order-status-actions')]/a[@href='/shop']" position="before">
            <a t-if="order_status_refund_detail_url" t-att-href="order_status_refund_detail_url" class="ut-order-status-secondary">Lihat Refund</a>
            <a t-if="not order_status_refund_detail_url and order_status_can_refund" href="/my/orders" class="ut-order-status-danger">Ajukan Refund dari Pesanan Saya</a>
        </xpath>
    </template>

    <template id="unitrade_refund_detail" name="UniTrade Refund Detail">
        <t t-call="website.layout">
            <t t-set="title">Detail Refund</t>
            <div class="ut-refund-detail-page">
                <main class="ut-refund-detail-shell">
                    <h1 class="ut-refund-detail-title">Detail Refund</h1>
                    <p class="ut-refund-detail-subtitle">Pantau status pengajuan refund dan bukti yang sudah dikirim.</p>

                    <div class="ut-refund-detail-grid">
                        <div>
                            <section class="ut-refund-card">
                                <h2>Informasi Refund</h2>
                                <div class="ut-refund-kv">
                                    <span>Nomor Case</span>
                                    <strong t-esc="dispute.name"/>
                                </div>
                                <div class="ut-refund-kv">
                                    <span>Status</span>
                                    <strong t-esc="dict(dispute._fields['state'].selection).get(dispute.state, dispute.state)"/>
                                </div>
                                <div class="ut-refund-kv">
                                    <span>Alasan</span>
                                    <strong t-esc="dict(dispute._fields['reason_code'].selection).get(dispute.reason_code, dispute.reason_code)"/>
                                </div>
                                <div class="ut-refund-kv">
                                    <span>Catatan Buyer</span>
                                    <strong t-esc="dispute.reason_note"/>
                                </div>
                                <div class="ut-refund-kv">
                                    <span>Nominal Diajukan</span>
                                    <strong t-field="dispute.requested_amount"/>
                                </div>
                                <div class="ut-refund-kv" t-if="dispute.approved_amount">
                                    <span>Nominal Disetujui</span>
                                    <strong t-field="dispute.approved_amount"/>
                                </div>
                            </section>

                            <section class="ut-refund-card">
                                <h2>Bukti</h2>
                                <div t-if="dispute.evidence_ids" class="ut-refund-evidence-list">
                                    <article t-foreach="dispute.evidence_ids" t-as="evidence" class="ut-refund-evidence-item">
                                        <div>
                                            <strong t-esc="dict(evidence._fields['evidence_type'].selection).get(evidence.evidence_type, evidence.evidence_type)"/>
                                            <p t-if="evidence.note" class="tw-m-0 tw-text-[13px] tw-text-[#6b7280]" t-esc="evidence.note"/>
                                            <p t-if="evidence.url" class="tw-m-0 tw-text-[13px]">
                                                <a t-att-href="evidence.url" target="_blank" rel="noopener">Buka link bukti</a>
                                            </p>
                                        </div>
                                        <a t-if="evidence.attachment_id" t-att-href="'/unitrade/refund/evidence/%s/download' % evidence.id" class="ut-refund-status-chip">Download</a>
                                    </article>
                                </div>
                                <p t-else="" class="tw-m-0 tw-text-[#6b7280]">Belum ada bukti.</p>
                            </section>

                            <section class="ut-refund-card" t-if="is_seller_view and dispute.state not in ('approved', 'rejected', 'resolved', 'cancelled')">
                                <h2>Respons Seller</h2>
                                <form t-att-action="'/seller/refund/%s/respond' % dispute.id" method="post" enctype="multipart/form-data" class="ut-refund-seller-response">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <textarea name="seller_response_note" placeholder="Tulis penjelasan atau klarifikasi seller."></textarea>
                                    <input type="file" name="seller_refund_evidence" accept="image/jpeg,image/png,image/webp,video/mp4,video/webm" multiple="multiple"/>
                                    <button type="submit" class="ut-refund-primary-link">Kirim Respons</button>
                                </form>
                            </section>
                        </div>

                        <aside>
                            <section class="ut-refund-card">
                                <h2>Ringkasan</h2>
                                <div class="ut-refund-kv">
                                    <span>Order</span>
                                    <strong t-esc="order.name"/>
                                </div>
                                <div class="ut-refund-kv">
                                    <span>Buyer</span>
                                    <strong t-esc="dispute.buyer_id.name"/>
                                </div>
                                <div class="ut-refund-kv">
                                    <span>Seller</span>
                                    <strong t-esc="dispute.seller_id.name if dispute.seller_id else 'Penjual UniTrade'"/>
                                </div>
                                <div class="ut-refund-kv">
                                    <span>Diajukan</span>
                                    <strong t-esc="dispute.submitted_at or dispute.create_date"/>
                                </div>
                                <div class="ut-refund-kv" t-if="dispute.admin_decision_note">
                                    <span>Catatan Admin</span>
                                    <strong t-esc="dispute.admin_decision_note"/>
                                </div>
                            </section>

                            <section class="ut-refund-card">
                                <a href="/my/orders" class="ut-refund-primary-link">Kembali ke Pesanan Saya</a>
                                <a t-att-href="'/unitrade/order/status/%s' % order.id" class="ut-refund-secondary-link tw-mt-3">Lihat Status Pesanan</a>
                            </section>
                        </aside>
                    </div>
                </main>
            </div>
        </t>
    </template>
</odoo>
