                                    <div class="tw-h-3.5 tw-bg-gray-200 tw-rounded tw-w-2/3 tw-mb-3 tw-animate-pulse"></div>
                                    <div class="tw-h-2.5 tw-bg-gray-200 tw-rounded tw-w-1/3 tw-mb-auto tw-animate-pulse"></div>
                                    <div class="tw-flex tw-justify-between tw-items-center tw-mt-3">
