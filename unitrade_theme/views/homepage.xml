                                        <div class="tw-h-3 tw-bg-gray-200 tw-rounded tw-w-1/4 tw-animate-pulse"></div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </t>
                </div>

                <!-- Muat Lebih Banyak Button -->
                <div class="tw-mt-10 tw-flex tw-justify-center">
                    <a href="/shop" class="tw-font-['Urbanist'] tw-font-bold tw-text-[16px] tw-text-black tw-border tw-border-solid tw-border-gray-200 tw-rounded-[12px] tw-px-8 tw-py-3 hover:tw-bg-gray-50 tw-transition-colors tw-no-underline">Muat Lebih Banyak</a>
                </div>
            </section>

            <t t-call="unitrade_theme.about_unitrade_section"/>

            <!-- Footer handled by website.layout inheritance -->
            </div>
        </xpath>
    </template>

</odoo>
