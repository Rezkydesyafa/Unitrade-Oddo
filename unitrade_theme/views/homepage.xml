    <template id="about_unitrade_section" name="AboutUniTradeSection">
        <section id="about-unitrade" class="AboutUniTradeSection ut-about-section ut-about-v2" aria-labelledby="ut-about-title">
            <div class="ut-about-v2-shell">
                <div class="ut-about-v2-row ut-about-v2-row-why">
                    <div class="ut-about-v2-copy ut-about-animate">
                        <div class="ut-about-v2-title-row">
                            <div class="ut-about-v2-dots" aria-hidden="true">
                                <span></span><span></span><span></span><span></span><span></span><span></span>
                            </div>
                            <div>
                                <h2 id="ut-about-title">Kenapa Belanja di UniTrade?</h2>
                                <p>Murah, nyaman, dan temukan produk unik hasil karya mahasiswa dari berbagai kampus.</p>
                            </div>
                        </div>
                        <div class="ut-about-v2-cone-card ut-about-animate" aria-hidden="true">
                            <img class="ut-about-v2-cone-shadow" src="/unitrade_theme/static/src/img/about/shadow-ellipse.svg" alt="" loading="lazy" decoding="async"/>
                            <img class="ut-about-v2-cone" src="/unitrade_theme/static/src/img/about/cone.png" alt="" loading="lazy" decoding="async"/>
                        </div>
                    </div>

                    <div class="ut-about-v2-stage ut-about-v2-stage-why">
                        <img class="ut-about-v2-ascii" src="/unitrade_theme/static/src/img/about/ascii-art.png" alt="" loading="lazy" decoding="async"/>
                        <img class="ut-about-v2-guide ut-about-v2-guide-product" src="/unitrade_theme/static/src/img/about/guide-151.svg" alt="" loading="lazy" decoding="async"/>
                        <img class="ut-about-v2-guide ut-about-v2-guide-transaction-a" src="/unitrade_theme/static/src/img/about/guide-150.svg" alt="" loading="lazy" decoding="async"/>
                        <img class="ut-about-v2-guide ut-about-v2-guide-transaction-b" src="/unitrade_theme/static/src/img/about/guide-152.svg" alt="" loading="lazy" decoding="async"/>
                        <img class="ut-about-v2-guide ut-about-v2-guide-price" src="/unitrade_theme/static/src/img/about/guide-156.svg" alt="" loading="lazy" decoding="async"/>

                        <div class="ut-about-v2-benefit ut-about-v2-benefit-product ut-about-animate">
                            <span>1</span>
                            <div>
                                <h3>Produk Kreatiff</h3>
                                <p>Produk unik dari berbagai kampus.</p>
                            </div>
                        </div>
                        <div class="ut-about-v2-benefit ut-about-v2-benefit-transaction ut-about-animate">
                            <span>2</span>
                            <div>
                                <h3>Transaksi aman</h3>
                                <p>Sistem pembayaran terpercaya.</p>
                            </div>
                        </div>
                        <div class="ut-about-v2-benefit ut-about-v2-benefit-price ut-about-animate">
                            <span>3</span>
                            <div>
                                <h3>Harga Ramah</h3>
                                <p>Diskon khusus pas untuk mahasiswa.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="ut-about-v2-row ut-about-v2-row-what">
                    <div class="ut-about-v2-copy ut-about-v2-copy-what ut-about-animate">
                        <div class="ut-about-v2-title-row">
                            <div class="ut-about-v2-dots" aria-hidden="true">
                                <span></span><span></span><span></span><span></span><span></span><span></span>
                            </div>
                            <div>
                                <h2>Apa Itu UniTrade?</h2>
                                <p>UniTrade adalah platform marketplace untuk mahasiswa dalam melakukan jual beli produk dan jasa. Mahasiswa dapat menjual kebutuhan akademik, barang bekas layak pakai, maupun jasa dengan sistem yang terstruktur, transparan, dan mudah digunakan. Fitur verifikasi penjual mahasiswa juga disediakan untuk meningkatkan keamanan dan kepercayaan dalam transaksi.</p>
                            </div>
                        </div>
                        <div class="ut-about-v2-bag-card ut-about-animate" aria-hidden="true">
                            <img src="/unitrade_theme/static/src/img/about/paper-bag.png" alt="" loading="lazy" decoding="async"/>
                        </div>
                    </div>

                    <div class="ut-about-v2-stage ut-about-v2-stage-cart ut-about-animate" aria-hidden="true">
                        <div class="ut-about-v2-road"></div>
                        <img class="ut-about-v2-cart" src="/unitrade_theme/static/src/img/about/shopping-cart.png" alt="" loading="lazy" decoding="async"/>
                    </div>
                </div>
            </div>
            <script>
                (function () {
                    function initAboutUniTradeAnimation() {
                        var sections = document.querySelectorAll('.AboutUniTradeSection');
                        if (!sections.length) {
                            return;
                        }
                        var reducedMotion = false;
                        if (window.matchMedia) {
                            reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                        }
                        sections.forEach(function (section) {
                            section.classList.add('ut-about-ready');
                            if (reducedMotion || !('IntersectionObserver' in window)) {
                                section.classList.add('ut-about-visible');
                                return;
                            }
                            var observer = new IntersectionObserver(function (entries) {
                                entries.forEach(function (entry) {
                                    if (entry.isIntersecting) {
                                        section.classList.add('ut-about-visible');
                                        observer.unobserve(section);
                                    }
                                });
                            }, {
                                threshold: 0.16,
                                rootMargin: '0px 0px -10% 0px'
                            });
                            observer.observe(section);
                        });
                    }
                    if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', initAboutUniTradeAnimation);
                    } else {
                        initAboutUniTradeAnimation();
                    }
                })();
            </script>
        </section>
    </template>

