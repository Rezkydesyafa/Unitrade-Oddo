    <template id="unitrade_homepage" inherit_id="website.homepage" name="UniTrade Homepage Override" active="True">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty tw-bg-white tw-w-full">
            <!-- Hero Section (Carousel) -->
            <section class="tw-py-8 tw-px-4 md:tw-px-8 tw-max-w-7xl tw-mx-auto tw-relative tw-z-10">
                <style>
                    #unitradeHeroCarousel {
                        background: #f8fafc;
                    }
                    .ut-hero-arrow {
                        box-sizing: border-box;
                        width: 48px;
                        height: 48px;
                        min-width: 48px;
                        min-height: 48px;
                        display: inline-flex;
                        align-items: center;
                        justify-content: center;
                        padding: 0;
                        border: 1px solid rgba(15, 23, 42, 0.12);
                        border-radius: 50%;
                        background: rgba(255, 255, 255, 0.64);
                        color: #111827;
                        line-height: 1;
                        appearance: none;
                        transition: background-color 180ms ease, border-color 180ms ease, transform 160ms ease;
                    }
                    .ut-hero-arrow:hover {
                        border-color: rgba(15, 23, 42, 0.2);
                        background: rgba(255, 255, 255, 0.92);
                    }
                    .ut-hero-arrow:active {
                        transform: scale(0.96);
                    }
                    .ut-hero-arrow svg {
                        display: block;
                        width: 20px;
                        height: 20px;
                        flex: 0 0 20px;
                    }
                    @media (max-width: 767.98px) {
                        .ut-hero-control-bar {
                            right: 12px;
                            bottom: 12px;
                            padding: 10px;
                            gap: 12px;
                        }
                        .ut-hero-arrow {
                            width: 40px;
                            height: 40px;
                            min-width: 40px;
                            min-height: 40px;
                        }
                    }
