                    <a t-att-href="'/unitrade/products?category=%s' % ut_category_health.id if ut_category_health else '/unitrade/products'" class="ut-category-card tw-bg-white tw-rounded-[22px] tw-h-[85px] tw-flex tw-items-center tw-px-6 tw-border tw-border-solid tw-border-gray-200 tw-shadow-sm hover:tw-shadow-md hover:tw-border-gray-300 tw-transition-all">
                        <img src="/unitrade_theme/static/src/img/categories/kesehatan-kecantikan.png" alt="Kesehatan &amp; Kecantikan" loading="lazy" decoding="async" class="ut-category-icon tw-rounded-xl tw-object-cover tw-mr-4 tw-shrink-0"/>
                        <div>
                            <h3 class="tw-font-semibold tw-text-[#212529] tw-text-base">Kesehatan &amp; Kecantikan</h3>
                            <p class="tw-text-xs tw-text-gray-400">Care essentials</p>
                        </div>
                    </a>
                    <a t-att-href="'/unitrade/products?category=%s' % ut_category_hobbies.id if ut_category_hobbies else '/unitrade/products'" class="ut-category-card tw-bg-white tw-rounded-[22px] tw-h-[85px] tw-flex tw-items-center tw-px-6 tw-border tw-border-solid tw-border-gray-200 tw-shadow-sm hover:tw-shadow-md hover:tw-border-gray-300 tw-transition-all">
                        <img src="/unitrade_theme/static/src/img/categories/hobi-koleksi.png" alt="Hobi &amp; Koleksi" loading="lazy" decoding="async" class="ut-category-icon tw-rounded-xl tw-object-cover tw-mr-4 tw-shrink-0"/>
                        <div>
                            <h3 class="tw-font-semibold tw-text-[#212529] tw-text-base">Hobi &amp; Koleksi</h3>
                            <p class="tw-text-xs tw-text-gray-400">Koleksi pribadi</p>
                        </div>
                    </a>
                    <a t-att-href="'/unitrade/products?category=%s' % ut_category_other.id if ut_category_other else '/unitrade/products'" class="ut-category-card tw-bg-white tw-rounded-[22px] tw-h-[85px] tw-flex tw-items-center tw-px-6 tw-border tw-border-solid tw-border-gray-200 tw-shadow-sm hover:tw-shadow-md hover:tw-border-gray-300 tw-transition-all">
                        <img src="/unitrade_theme/static/src/img/categories/lainnya.png" alt="Lainnya" loading="lazy" decoding="async" class="ut-category-icon tw-rounded-xl tw-object-cover tw-mr-4 tw-shrink-0"/>
                        <div>
                            <h3 class="tw-font-semibold tw-text-[#212529] tw-text-base">Lainnya</h3>
                            <p class="tw-text-xs tw-text-gray-400">Lama</p>
                        </div>
                    </a>
                </div>
            </section>

            <!-- Kualitas Terbaik Section -->
            <section class="tw-max-w-7xl tw-mx-auto tw-px-4 md:tw-px-8 tw-py-8">
                <div class="tw-flex tw-justify-between tw-items-center tw-mb-6">
                    <h2 class="tw-text-2xl tw-font-bold tw-text-[#212529] tw-m-0">Kualitas Terbaik</h2>
                    <a href="/shop" class="tw-font-['Urbanist'] tw-font-bold tw-text-[15px] tw-text-black tw-border tw-border-solid tw-border-gray-200 tw-rounded-[24px] tw-px-6 tw-py-2 hover:tw-bg-gray-50 tw-transition-colors tw-no-underline">Explore All</a>
                </div>

                <div class="ut-product-card-grid tw-grid">
                    <t t-foreach="products or []" t-as="product">
                        <t t-set="ut_card_href" t-value="product.website_url"/>
                        <t t-set="ut_card_product" t-value="product"/>
                        <t t-set="ut_card_class" t-value="'tw-bg-white tw-border tw-border-solid tw-border-gray-200 tw-rounded-[14px] tw-overflow-hidden tw-shadow-sm hover:tw-shadow-md hover:-tw-translate-y-1 tw-transition-all tw-duration-300 tw-flex tw-flex-col tw-h-full tw-no-underline tw-group'"/>
                        <t t-call="unitrade_theme.unitrade_product_card"/>
                    </t>
                    
                    <!-- Fallback placeholders if no products found in database yet -->
                    <t t-if="not products">
                        <t t-foreach="range(6)" t-as="i">
                            <div class="tw-bg-white tw-border tw-border-solid tw-border-gray-200 tw-rounded-[14px] tw-overflow-hidden tw-shadow-sm tw-flex tw-flex-col tw-h-full">
                                <div>
                                    <div class="tw-h-[180px] tw-w-full tw-rounded-t-[14px] tw-bg-gray-200 tw-animate-pulse"></div>
