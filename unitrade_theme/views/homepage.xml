                            <picture class="tw-absolute tw-inset-0 tw-block tw-h-full tw-w-full">
                                <source type="image/webp" srcset="/unitrade_theme/static/src/img/hero/hero-banner-4-960.webp 960w, /unitrade_theme/static/src/img/hero/hero-banner-4-1920.webp 1920w" sizes="(max-width: 768px) 100vw, 1280px"/>
