            <script>
                (function () {
                    function initAboutUniTradeAnimation() {
                        var sections = document.querySelectorAll('.AboutUniTradeSection');
                        if (!sections.length) {
                            return;
                        }
                        var reducedMotion = false;
                        if (window.matchMedia) {
                            reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                        }
                        sections.forEach(function (section) {
                            section.classList.add('ut-about-ready');
                            if (reducedMotion || !('IntersectionObserver' in window)) {
                                section.classList.add('ut-about-visible');
                                return;
                            }
                            var observer = new IntersectionObserver(function (entries) {
                                entries.forEach(function (entry) {
                                    if (entry.isIntersecting) {
                                        section.classList.add('ut-about-visible');
                                        observer.unobserve(section);
                                    }
                                });
                            }, {
                                threshold: 0.16,
                                rootMargin: '0px 0px -10% 0px'
                            });
                            observer.observe(section);
                        });
                    }
                    if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', initAboutUniTradeAnimation);
                    } else {
                        initAboutUniTradeAnimation();
                    }
                })();
            </script>
        </section>
