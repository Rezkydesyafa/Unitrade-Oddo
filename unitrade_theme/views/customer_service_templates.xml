<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="customer_service_page" name="UniTrade Customer Service">
        <t t-call="website.layout">
            <t t-set="title" t-value="page_title"/>
            <style type="text/css">
                .ut-csh-page { background: #f9f9fb; font-family: 'Urbanist', Inter, sans-serif; min-height: 100vh; padding: 40px 24px 64px; }
                .ut-csh-shell { max-width: 1080px; margin: 0 auto; width: 100%; }
                .ut-csh-hero { text-align: center; margin-bottom: 48px; }
                .ut-csh-title { margin: 0 0 24px; color: #212529; font-size: 32px; line-height: 38px; font-weight: 700; }
                .ut-csh-search-wrap { position: relative; max-width: 640px; margin: 0 auto; }
                .ut-csh-search-icon { position: absolute; left: 18px; top: 50%; transform: translateY(-50%); color: #6b7280; }
                .ut-csh-search { width: 100%; border: 1px solid #f0f0f0; border-radius: 999px; padding: 16px 24px 16px 46px; font-size: 16px; font-family: inherit; outline: none; background: #fff; box-shadow: 0 4px 20px -4px rgba(0,0,0,.05); }
                .ut-csh-search:focus { border-color: #212529; box-shadow: 0 0 0 1px #212529; }
                .ut-csh-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-bottom: 56px; }
                .ut-csh-card { display: flex; flex-direction: column; align-items: flex-start; text-align: left; background: #fff; border: 1px solid #f0f0f0; border-radius: 14px; padding: 24px; cursor: pointer; transition: box-shadow .25s ease, transform .15s ease, border-color .2s ease; font-family: inherit; }
                .ut-csh-card:hover { box-shadow: 0 8px 24px -4px rgba(0,0,0,.08); transform: translateY(-2px); }
                .ut-csh-card.is-primary { border-color: #212529; }
                .ut-csh-card-icon { width: 48px; height: 48px; border-radius: 10px; background: #f3f3f5; color: #212529; display: inline-flex; align-items: center; justify-content: center; font-size: 20px; margin-bottom: 16px; transition: background .2s ease, color .2s ease; }
                .ut-csh-card:hover .ut-csh-card-icon, .ut-csh-card.is-primary .ut-csh-card-icon { background: #212529; color: #fff; }
                .ut-csh-card-title { margin: 0 0 8px; color: #212529; font-size: 18px; line-height: 24px; font-weight: 600; }
                .ut-csh-card-desc { margin: 0; color: #6b7280; font-size: 14px; line-height: 21px; }
                .ut-csh-section { max-width: 760px; margin: 0 auto 56px; }
                .ut-csh-section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
                .ut-csh-section-title { margin: 0; color: #212529; font-size: 20px; font-weight: 700; }
                .ut-csh-link { display: inline-flex; align-items: center; gap: 4px; color: #0c1014; font-size: 14px; font-weight: 600; text-decoration: none; }
                .ut-csh-link:hover { opacity: .7; color: #0c1014; text-decoration: none; }
                .ut-csh-faq { background: #fff; border: 1px solid #f0f0f0; border-radius: 14px; overflow: hidden; box-shadow: 0 2px 10px -2px rgba(0,0,0,.03); }
                .ut-csh-faq-item { border-bottom: 1px solid #f0f0f0; }
                .ut-csh-faq-item:last-child { border-bottom: 0; }
                .ut-csh-faq-btn { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 22px 24px; background: #fff; border: 0; cursor: pointer; text-align: left; font-family: inherit; color: #212529; font-size: 16px; font-weight: 500; transition: background .15s ease; }
                .ut-csh-faq-btn:hover { background: #f3f3f5; }
                .ut-csh-faq-icon { color: #6b7280; transition: transform .3s ease; flex: 0 0 auto; }
                .ut-csh-faq-btn[aria-expanded="true"] .ut-csh-faq-icon { transform: rotate(180deg); }
                .ut-csh-faq-body { max-height: 0; opacity: 0; overflow: hidden; transition: max-height .3s ease-out, opacity .3s ease-out; padding: 0 24px; }
                .ut-csh-faq-body.is-open { max-height: 320px; opacity: 1; }
                .ut-csh-faq-body p { margin: 0; padding-bottom: 22px; color: #6b7280; font-size: 14px; line-height: 22px; }
                .ut-csh-help { max-width: 760px; margin: 0 auto; display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 24px; background: #fff; border: 1px solid #f0f0f0; border-radius: 14px; padding: 32px; box-shadow: 0 2px 10px -2px rgba(0,0,0,.03); }
                .ut-csh-help h3 { margin: 0 0 8px; color: #212529; font-size: 20px; font-weight: 600; }
                .ut-csh-help p { margin: 0; color: #6b7280; font-size: 14px; line-height: 21px; }
                .ut-csh-btn { display: inline-flex; align-items: center; gap: 8px; background: #212529; color: #fff; border: 0; border-radius: 999px; padding: 13px 24px; font-family: inherit; font-size: 14px; font-weight: 600; cursor: pointer; white-space: nowrap; transition: opacity .15s ease; }
                .ut-csh-btn:hover { opacity: .9; color: #fff; }
                @media (max-width: 900px) { .ut-csh-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
                @media (max-width: 640px) {
                    .ut-csh-grid { grid-template-columns: 1fr; }
                    .ut-csh-help { flex-direction: column; text-align: center; }
                }
            </style>
            <main class="ut-csh-page">
                <div class="ut-csh-shell">
                    <section class="ut-csh-hero">
                        <h1 class="ut-csh-title">Customer Service</h1>
                        <div class="ut-csh-search-wrap">
                            <span class="ut-csh-search-icon"><i class="fa fa-search"/></span>
                            <input type="text" class="ut-csh-search" placeholder="Cari kendala atau pertanyaan kamu"/>
                        </div>
                    </section>

                    <section class="ut-csh-grid">
                        <button type="button" class="ut-csh-card" data-cs-topic="Saya butuh bantuan terkait pesanan saya.">
                            <span class="ut-csh-card-icon"><i class="fa fa-archive"/></span>
                            <h3 class="ut-csh-card-title">Pesanan</h3>
                            <p class="ut-csh-card-desc">Status pesanan, detail transaksi, &amp; histori.</p>
                        </button>
                        <button type="button" class="ut-csh-card" data-cs-topic="Saya ada pertanyaan tentang pembayaran.">
                            <span class="ut-csh-card-icon"><i class="fa fa-credit-card"/></span>
                            <h3 class="ut-csh-card-title">Pembayaran</h3>
                            <p class="ut-csh-card-desc">Metode bayar, verifikasi, &amp; saldo Escrow.</p>
                        </button>
                        <button type="button" class="ut-csh-card" data-cs-topic="Saya ingin menanyakan proses pengiriman.">
                            <span class="ut-csh-card-icon"><i class="fa fa-truck"/></span>
                            <h3 class="ut-csh-card-title">Pengiriman</h3>
                            <p class="ut-csh-card-desc">Proses handoff, lokasi COD, &amp; konfirmasi.</p>
                        </button>
                        <button type="button" class="ut-csh-card" data-cs-topic="Saya ingin mengajukan refund / komplain.">
                            <span class="ut-csh-card-icon"><i class="fa fa-undo"/></span>
                            <h3 class="ut-csh-card-title">Refund &amp; Komplain</h3>
                            <p class="ut-csh-card-desc">Pengembalian dana, mediasi, &amp; lapor barang.</p>
                        </button>
                        <button type="button" class="ut-csh-card" data-cs-topic="Saya butuh bantuan akun dan keamanan.">
                            <span class="ut-csh-card-icon"><i class="fa fa-shield"/></span>
                            <h3 class="ut-csh-card-title">Akun &amp; Keamanan</h3>
                            <p class="ut-csh-card-desc">Password, verifikasi data, &amp; proteksi privasi.</p>
                        </button>
                        <button type="button" class="ut-csh-card is-primary" data-cs-open="1">
                            <span class="ut-csh-card-icon"><i class="fa fa-headphones"/></span>
                            <h3 class="ut-csh-card-title">Chat Customer Service</h3>
                            <p class="ut-csh-card-desc">Hubungi tim kami langsung untuk bantuan cepat.</p>
                        </button>
                    </section>

                    <section class="ut-csh-section">
                        <div class="ut-csh-section-head">
                            <h2 class="ut-csh-section-title">Pertanyaan Populer</h2>
                            <a href="/faq" class="ut-csh-link">Lihat Semua FAQ <i class="fa fa-chevron-right"/></a>
                        </div>
                        <div class="ut-csh-faq" data-cs-faq="1">
                            <div class="ut-csh-faq-item">
                                <button type="button" class="ut-csh-faq-btn" aria-expanded="false">
                                    <span>Bagaimana cara kerja Escrow UniTrade?</span>
                                    <i class="fa fa-chevron-down ut-csh-faq-icon"/>
                                </button>
                                <div class="ut-csh-faq-body"><p>Dana Anda ditahan dengan aman oleh sistem Escrow UniTrade sampai Anda menerima barang dan mengonfirmasi bahwa barang sesuai deskripsi. Setelah konfirmasi, dana baru diteruskan ke penjual.</p></div>
                            </div>
                            <div class="ut-csh-faq-item">
                                <button type="button" class="ut-csh-faq-btn" aria-expanded="false">
                                    <span>Kapan saya bisa bertemu seller?</span>
                                    <i class="fa fa-chevron-down ut-csh-faq-icon"/>
                                </button>
                                <div class="ut-csh-faq-body"><p>Waktu dan lokasi pertemuan (handoff) disepakati bersama melalui fitur chat setelah pembayaran berhasil diverifikasi oleh sistem.</p></div>
                            </div>
                            <div class="ut-csh-faq-item">
                                <button type="button" class="ut-csh-faq-btn" aria-expanded="false">
                                    <span>Apa yang harus dilakukan jika barang tidak sesuai?</span>
                                    <i class="fa fa-chevron-down ut-csh-faq-icon"/>
                                </button>
                                <div class="ut-csh-faq-body"><p>Jangan menekan tombol 'Pesanan Selesai'. Segera gunakan fitur Komplain di halaman detail pesanan untuk meminta mediasi dan proses refund.</p></div>
                            </div>
                            <div class="ut-csh-faq-item">
                                <button type="button" class="ut-csh-faq-btn" aria-expanded="false">
                                    <span>Berapa lama proses pencairan dana (refund)?</span>
                                    <i class="fa fa-chevron-down ut-csh-faq-icon"/>
                                </button>
                                <div class="ut-csh-faq-body"><p>Proses refund memakan waktu 1-3 hari kerja tergantung pada metode pembayaran awal yang Anda gunakan.</p></div>
                            </div>
                        </div>
                    </section>

                    <section>
                        <div class="ut-csh-help">
                            <div>
                                <h3>Butuh bantuan lebih lanjut?</h3>
                                <p>Tim Customer Service kami siap membantu Anda setiap hari pukul 08:00 - 22:00 WIB.</p>
                            </div>
                            <button type="button" class="ut-csh-btn" data-cs-open="1">
                                <i class="fa fa-comment"/> Chat Customer Service
                            </button>
                        </div>
                    </section>
                </div>
            </main>

            <script type="text/javascript">
                <![CDATA[
                (function () {
                    function initCustomerServiceHelp() {
                        var root = document.querySelector(".ut-csh-page");
                        if (!root) { return; }

                        // FAQ accordion
                        var faqButtons = root.querySelectorAll(".ut-csh-faq-btn");
                        faqButtons.forEach(function (button) {
                            button.addEventListener("click", function () {
                                var expanded = button.getAttribute("aria-expanded") === "true";
                                faqButtons.forEach(function (other) {
                                    other.setAttribute("aria-expanded", "false");
                                    var body = other.nextElementSibling;
                                    if (body) { body.classList.remove("is-open"); }
                                });
                                if (!expanded) {
                                    button.setAttribute("aria-expanded", "true");
                                    var body = button.nextElementSibling;
                                    if (body) { body.classList.add("is-open"); }
                                }
                            });
                        });

                        // Buka chatbot AI (widget floating unitrade_cs_ai)
                        function openChatbot(topic) {
                            window.dispatchEvent(new CustomEvent("unitrade_cs:open", {
                                detail: { topic: topic || "" }
                            }));
                        }
                        root.querySelectorAll("[data-cs-open]").forEach(function (el) {
                            el.addEventListener("click", function () { openChatbot(""); });
                        });
                        root.querySelectorAll("[data-cs-topic]").forEach(function (el) {
                            el.addEventListener("click", function () {
                                openChatbot(el.getAttribute("data-cs-topic"));
                            });
                        });
                    }

                    if (document.readyState === "loading") {
                        document.addEventListener("DOMContentLoaded", initCustomerServiceHelp);
                    } else {
                        initCustomerServiceHelp();
                    }
                }());
                ]]>
            </script>
        </t>
    </template>

    <template id="customer_service_tickets_page" name="UniTrade Customer Service Tickets">
        <t t-call="website.layout">
            <t t-set="title" t-value="page_title"/>
            <main class="ut-cs-page tw-min-h-screen tw-bg-[#f9fafb] tw-px-4 tw-pb-16 tw-pt-10 md:tw-px-8">
                <section class="ut-cs-list-shell tw-mx-auto tw-w-full tw-max-w-[1024px]">
                    <div class="tw-mb-8 tw-flex tw-flex-col tw-gap-3 md:tw-flex-row md:tw-items-end md:tw-justify-between">
                        <div>
                            <a href="/customer-service" class="tw-mb-4 tw-inline-flex tw-text-[14px] tw-font-semibold tw-text-[#667085] tw-no-underline hover:tw-text-[#101828]">
                                Kembali ke Customer Service
                            </a>
                            <h1 class="tw-m-0 tw-text-[36px] tw-font-semibold tw-leading-tight tw-text-[#101828] md:tw-text-[44px]">Tiket Bantuan</h1>
                            <p class="tw-mt-2 tw-text-[16px] tw-leading-6 tw-text-[#667085]">Pantau semua tiket bantuan yang pernah Anda kirim.</p>
                        </div>
                    </div>

                    <div class="ut-cs-panel tw-bg-white">
                        <t t-if="tickets">
                            <div class="ut-cs-ticket-list-page">
                                <t t-foreach="tickets" t-as="ticket">
                                    <a t-att-href="ticket.get('detail_url')" class="ut-cs-ticket-row tw-no-underline">
                                        <div>
                                            <div class="tw-flex tw-flex-wrap tw-items-center tw-gap-3">
                                                <strong class="tw-text-[16px] tw-text-[#101828]" t-esc="ticket.get('name')"/>
                                                <span t-att-class="'ut-cs-status-badge is-%s' % ticket.get('status_tone')" t-esc="ticket.get('status_label')"/>
                                            </div>
                                            <h2 class="tw-mb-1 tw-mt-3 tw-text-[18px] tw-font-semibold tw-text-[#101828]" t-esc="ticket.get('title')"/>
                                            <p class="tw-m-0 tw-text-[14px] tw-leading-6 tw-text-[#667085]" t-esc="ticket.get('summary')"/>
                                            <div class="tw-mt-3 tw-flex tw-flex-wrap tw-gap-3 tw-text-[13px] tw-font-medium tw-text-[#98a2b3]">
                                                <span t-esc="ticket.get('category_label')"/>
                                                <span t-if="ticket.get('order_name')" t-esc="ticket.get('order_name')"/>
                                                <span t-esc="ticket.get('created_at')"/>
                                            </div>
                                        </div>
                                        <span class="ut-cs-ticket-arrow" aria-hidden="true">
                                            <i class="fa fa-chevron-right"></i>
                                        </span>
                                    </a>
                                </t>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="ut-cs-empty-state">
                                <h2>Belum ada tiket bantuan.</h2>
                                <p>Kirim tiket pertama Anda melalui halaman Customer Service.</p>
                                <a href="/customer-service">Buat Tiket</a>
                            </div>
                        </t>
                    </div>
                </section>
            </main>
        </t>
    </template>

    <template id="customer_service_ticket_detail_page" name="UniTrade Customer Service Ticket Detail">
        <t t-call="website.layout">
            <t t-set="title" t-value="page_title"/>
            <main class="ut-cs-page tw-min-h-screen tw-bg-[#f9fafb] tw-px-4 tw-pb-16 tw-pt-10 md:tw-px-8">
                <section class="ut-cs-detail-shell tw-mx-auto tw-w-full tw-max-w-[960px]">
                    <a href="/my/customer-service/tickets" class="tw-mb-5 tw-inline-flex tw-text-[14px] tw-font-semibold tw-text-[#667085] tw-no-underline hover:tw-text-[#101828]">
                        Kembali ke daftar tiket
                    </a>
                    <div class="ut-cs-panel tw-bg-white">
                        <t t-set="refund" t-value="ticket.get('refund') or {}"/>
                        <div class="tw-flex tw-flex-col tw-gap-4 md:tw-flex-row md:tw-items-start md:tw-justify-between">
                            <div>
                                <div class="tw-flex tw-flex-wrap tw-items-center tw-gap-3">
                                    <strong class="tw-text-[18px] tw-text-[#101828]" t-esc="ticket.get('name')"/>
                                    <span t-att-class="'ut-cs-status-badge is-%s' % ticket.get('status_tone')" t-esc="ticket.get('status_label')"/>
                                </div>
                                <h1 class="tw-mb-2 tw-mt-4 tw-text-[32px] tw-font-semibold tw-leading-tight tw-text-[#101828]" t-esc="ticket.get('title')"/>
                                <p class="tw-m-0 tw-text-[14px] tw-font-medium tw-text-[#667085]" t-esc="ticket.get('created_at')"/>
                            </div>
                        </div>

                        <div class="ut-cs-detail-meta">
                            <div>
                                <span>Kategori</span>
                                <strong t-esc="ticket.get('category_label')"/>
                            </div>
                            <div t-if="ticket.get('order_name')">
                                <span>Nomor Pesanan</span>
                                <strong t-esc="ticket.get('order_name')"/>
                            </div>
                        </div>

                        <section class="ut-cs-refund-callout" t-if="refund.get('message')">
                            <div>
                                <h2 t-esc="refund.get('title')"/>
                                <p t-esc="refund.get('message')"/>
                                <span t-if="refund.get('state_label')" t-esc="refund.get('state_label')"/>
                            </div>
                            <a t-if="refund.get('url')"
                               t-att-href="refund.get('url')"
                               class="tw-no-underline"
                               t-esc="refund.get('label')"/>
                        </section>

                        <section class="ut-cs-detail-section">
                            <h2>Deskripsi Keluhan</h2>
                            <p t-esc="ticket.get('description')"/>
                        </section>

                        <section class="ut-cs-detail-section" t-if="ticket.get('evidence')">
                            <h2>Bukti Upload</h2>
                            <div class="ut-cs-evidence-grid">
                                <t t-foreach="ticket.get('evidence')" t-as="item">
                                    <a t-att-href="item.get('url')" target="_blank" rel="noopener" class="ut-cs-evidence-item tw-no-underline">
                                        <t t-if="item.get('is_video')">
                                            <video t-att-src="item.get('url')" controls="controls"></video>
                                        </t>
                                        <t t-else="">
                                            <img t-att-src="item.get('url')" t-att-alt="item.get('name')"/>
                                        </t>
                                        <span t-esc="item.get('name')"/>
                                    </a>
                                </t>
                            </div>
                        </section>

                        <section class="ut-cs-detail-section" t-if="ticket.get('resolved_note')">
                            <h2>Catatan Penyelesaian</h2>
                            <p t-esc="ticket.get('resolved_note')"/>
                            <small t-if="ticket.get('resolved_at')" t-esc="ticket.get('resolved_at')"/>
                        </section>

                        <section class="ut-cs-detail-section">
                            <h2>Thread Bantuan</h2>
                            <div class="ut-cs-thread-list" t-if="ticket.get('messages')">
                                <t t-foreach="ticket.get('messages')" t-as="message">
                                    <article t-att-class="'ut-cs-thread-message is-%s' % message.get('type')">
                                        <div class="ut-cs-thread-meta">
                                            <strong t-esc="message.get('author')"/>
                                            <span t-esc="message.get('type_label')"/>
                                            <small t-esc="message.get('created_at')"/>
                                        </div>
                                        <p t-esc="message.get('body')"/>
                                    </article>
                                </t>
                            </div>
                            <div class="ut-cs-recent-empty" t-else="">
                                Belum ada balasan pada tiket ini.
                            </div>
                        </section>

                        <form class="ut-cs-reply-form"
                              data-cs-reply-form="1"
                              t-att-data-reply-url="ticket.get('reply_url')">
                            <label class="ut-cs-field">
                                <span>Balas Customer Service</span>
                                <textarea name="body"
                                          placeholder="Tambahkan informasi lanjutan untuk Customer Service..."
                                          required="required"></textarea>
                            </label>
                            <div class="ut-cs-reply-actions">
                                <button type="submit" class="ut-cs-submit">Kirim Balasan</button>
                                <div class="ut-cs-message tw-hidden" data-cs-reply-message="1"></div>
                            </div>
                        </form>
                    </div>
                </section>
            </main>
        </t>
    </template>
</odoo>
