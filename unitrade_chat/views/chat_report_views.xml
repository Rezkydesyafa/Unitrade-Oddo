<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_unitrade_chat_report_tree" model="ir.ui.view">
        <field name="name">unitrade.chat.report.tree</field>
        <field name="model">unitrade.chat.report</field>
        <field name="arch" type="xml">
            <tree string="Laporan Chat" decoration-danger="state == 'blocked'" decoration-muted="state == 'rejected'">
                <field name="create_date"/>
                <field name="state"/>
                <field name="reporter_user_id"/>
                <field name="reported_user_id"/>
                <field name="reason"/>
                <field name="reviewer_user_id"/>
                <field name="reviewed_at"/>
            </tree>
        </field>
    </record>

    <record id="view_unitrade_chat_report_form" model="ir.ui.view">
        <field name="name">unitrade.chat.report.form</field>
        <field name="model">unitrade.chat.report</field>
        <field name="arch" type="xml">
            <form string="Laporan Chat">
                <header>
                    <button name="action_start_review" string="Mulai Review" type="object" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_mark_reviewed" string="Tandai Selesai" type="object" class="btn-success" invisible="state not in ('submitted', 'under_review')"/>
                    <button name="action_reject" string="Tolak" type="object" class="btn-secondary" invisible="state not in ('submitted', 'under_review')"/>
                    <button name="action_block_reported_user" string="Block User dari Chat" type="object" class="btn-danger" invisible="state == 'blocked'"/>
                    <button name="action_unblock_reported_user" string="Unblock User" type="object" invisible="state != 'blocked'"/>
                    <field name="state" widget="statusbar" statusbar_visible="submitted,under_review,reviewed,rejected,blocked"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="conversation_id" readonly="1"/>
                            <field name="reporter_user_id" readonly="1"/>
                            <field name="reported_user_id" readonly="1"/>
                            <field name="reason" readonly="1"/>
                        </group>
                        <group>
                            <field name="proof_attachment_id" readonly="1"/>
                            <field name="reviewer_user_id" readonly="1"/>
                            <field name="reviewed_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Catatan Admin">
                        <field name="admin_note" placeholder="Tambahkan catatan review internal..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_unitrade_chat_report_search" model="ir.ui.view">
        <field name="name">unitrade.chat.report.search</field>
        <field name="model">unitrade.chat.report</field>
        <field name="arch" type="xml">
            <search string="Cari Laporan Chat">
                <field name="reporter_user_id"/>
                <field name="reported_user_id"/>
                <field name="reason"/>
                <filter name="submitted" string="Baru" domain="[('state', '=', 'submitted')]"/>
                <filter name="under_review" string="Sedang Review" domain="[('state', '=', 'under_review')]"/>
                <filter name="blocked" string="Blocked" domain="[('state', '=', 'blocked')]"/>
                <group expand="0" string="Kelompokkan">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_reason" string="Alasan" context="{'group_by': 'reason'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_unitrade_chat_reports" model="ir.actions.act_window">
        <field name="name">Moderasi Chat</field>
        <field name="res_model">unitrade.chat.report</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_submitted': 1}</field>
    </record>

    <menuitem id="menu_unitrade_chat_root"
        name="Chat"
        parent="unitrade_seller.menu_unitrade_root"
        sequence="30"/>
    <menuitem id="menu_unitrade_chat_reports"
        name="Moderasi Laporan"
        parent="menu_unitrade_chat_root"
        action="action_unitrade_chat_reports"
        groups="unitrade_seller.group_unitrade_admin"
        sequence="10"/>

    <record id="ir_cron_unitrade_chat_cleanup" model="ir.cron">
        <field name="name">UniTrade Chat Attachment Cleanup</field>
        <field name="model_id" ref="model_unitrade_chat_rate_limit"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>
