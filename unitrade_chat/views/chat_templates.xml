<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="chat_page_template" name="UniTrade Chat Page">
        <t t-call="website.layout">
            <div class="ut-chat-page tw-bg-[#f5f5f7] tw-font-['Urbanist']">
                <div id="ut-chat-owl"
                    t-att-data-initial-conversation-id="initial_conversation_id or 0">
                    <div class="ut-chat-loading tw-flex tw-min-h-[520px] tw-items-center tw-justify-center tw-text-[#515154]">
                        Memuat chat...
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
