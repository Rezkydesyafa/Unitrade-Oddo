<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="unitrade_chat_navbar_icon" inherit_id="unitrade_theme.unitrade_header" name="UniTrade Chat Navbar Icon">
        <xpath expr="//a[@href='/shop/cart']" position="after">
            <t t-set="unitrade_chat_unread_count" t-value="request.env['unitrade.chat.conversation'].nav_unread_count(current_user)"/>
            <a href="/unitrade/chat"
                title="Chat"
                aria-label="Chat"
                class="tw-relative tw-flex tw-items-center tw-justify-center tw-w-10 tw-h-10 tw-rounded-full hover:tw-bg-[#fffffc] tw-transition-colors tw-mr-1 tw-text-[#fffffc] hover:tw-text-[#1f1f1f] tw-no-underline tw-group">
                <svg xmlns="http://www.w3.org/2000/svg" class="tw-w-6 tw-h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"></path>
                </svg>
                <t t-if="unitrade_chat_unread_count">
                    <span class="tw-absolute tw-top-0 tw-right-0 tw-bg-red-500 tw-text-[#fffffc] tw-text-[10px] tw-font-bold tw-px-1.5 tw-py-0.5 tw-rounded-full tw-min-w-[16px] tw-text-center tw-transform tw-translate-x-1 tw--translate-y-1">
                        <t t-esc="unitrade_chat_unread_count if unitrade_chat_unread_count &lt; 100 else '99+'"/>
                    </span>
                </t>
            </a>
        </xpath>
    </template>

    <template id="chat_page_template" name="UniTrade Chat Page">
        <t t-call="website.layout">
            <div class="ut-chat-page tw-bg-[#f7f7f7] tw-font-['Urbanist']">
                <div id="ut-chat-owl"
                    t-att-data-initial-conversation-id="initial_conversation_id or 0">
                    <div class="ut-chat-shell ut-chat-initial-skeleton" aria-hidden="true">
                        <aside class="ut-chat-sidebar">
                            <div class="ut-chat-sidebar-title">
                                <span class="ut-chat-skeleton-line ut-chat-skeleton ut-is-title"></span>
                            </div>
                            <div class="ut-chat-list ut-chat-skeleton-list">
                                <t t-foreach="[1, 2, 3, 4]" t-as="item">
                                    <div class="ut-chat-list-item ut-chat-skeleton-item">
                                        <span class="ut-chat-skeleton-avatar ut-chat-skeleton"></span>
                                        <span class="ut-chat-list-main">
                                            <span class="ut-chat-skeleton-line ut-chat-skeleton ut-is-title"></span>
                                            <span class="ut-chat-skeleton-line ut-chat-skeleton ut-is-subtitle"></span>
                                        </span>
                                    </div>
                                </t>
                            </div>
                        </aside>
                        <main class="ut-chat-main">
                            <div class="ut-chat-header ut-chat-skeleton-header">
                                <span class="ut-chat-skeleton-avatar ut-chat-skeleton"></span>
                                <div class="ut-chat-header-text">
                                    <span class="ut-chat-skeleton-line ut-chat-skeleton ut-is-title"></span>
                                    <span class="ut-chat-skeleton-line ut-chat-skeleton ut-is-status"></span>
                                </div>
                                <span class="ut-chat-skeleton-icon ut-chat-skeleton"></span>
                            </div>
                            <div class="ut-chat-messages ut-chat-skeleton-messages">
                                <div class="ut-chat-message ut-is-theirs">
                                    <span class="ut-chat-skeleton-message-avatar ut-chat-skeleton"></span>
                                    <span class="ut-chat-skeleton-bubble ut-chat-skeleton"></span>
                                </div>
                                <div class="ut-chat-message ut-is-mine">
                                    <span class="ut-chat-skeleton-bubble ut-chat-skeleton ut-is-mine"></span>
                                    <span class="ut-chat-skeleton-message-avatar ut-chat-skeleton"></span>
                                </div>
                            </div>
                            <footer class="ut-chat-composer ut-chat-skeleton-composer">
                                <span class="ut-chat-skeleton-input ut-chat-skeleton"></span>
                            </footer>
                        </main>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
