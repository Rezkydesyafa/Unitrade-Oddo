<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="unitrade_chat_navbar_icon" inherit_id="unitrade_theme.unitrade_navbar" name="UniTrade Chat Navbar Icon">
        <xpath expr="//a[@href='/shop/cart']" position="before">
            <t t-set="unitrade_chat_model_available" t-value="request.env.registry.models.get('unitrade.chat.conversation')"/>
            <t t-set="unitrade_chat_unread_count" t-value="0"/>
            <t t-if="unitrade_chat_model_available">
                <t t-set="unitrade_chat_unread_count" t-value="request.env['unitrade.chat.conversation'].nav_unread_count(current_user, role='buyer')"/>
                <a href="/unitrade/chat"
                    title="Chat"
                    aria-label="Chat"
                    class="tw-relative tw-flex tw-size-[38px] tw-shrink-0 tw-items-center tw-justify-center tw-rounded-full tw-bg-[#212529] tw-text-white tw-no-underline tw-transition-colors hover:tw-bg-black">
                    <img src="/unitrade_theme/static/src/img/navbar-message.svg" alt="" class="tw-size-6"/>
                    <t t-if="unitrade_chat_unread_count">
                        <span class="tw-absolute tw-right-[-4px] tw-top-[-5px] tw-flex tw-min-w-[17px] tw-items-center tw-justify-center tw-rounded-full tw-bg-red-500 tw-px-1 tw-text-[10px] tw-font-bold tw-leading-[17px] tw-text-white">
                            <t t-esc="unitrade_chat_unread_count if unitrade_chat_unread_count &lt; 100 else '99+'"/>
                        </span>
                    </t>
                </a>
            </t>
        </xpath>
    </template>

    <template id="chat_frontend_fallback_css"
              inherit_id="web.frontend_layout"
              name="UniTrade Chat Static Fallback CSS">
        <xpath expr="//t[@t-call-assets='web.assets_frontend']" position="after">
            <link rel="stylesheet" href="/unitrade_chat/static/src/css/chat.css?v=20260604"/>
        </xpath>
    </template>

    <template id="chat_page_template" name="UniTrade Chat Page">
        <t t-call="website.layout">
            <t t-if="seller_dashboard_chat">
                <div class="ut-chat-seller-dashboard-page tw-fixed tw-inset-0 tw-z-[1100] tw-overflow-auto tw-bg-[#f5f5f7] tw-font-['Urbanist']">
                    <div class="ut-dash-stage ut-chat-seller-stage">
                        <div class="ut-dash-promo tw-flex tw-items-center tw-justify-between tw-bg-white tw-px-[57px] tw-text-[12px] tw-leading-6 tw-text-black">
                            <div class="tw-flex tw-items-center tw-gap-[18px]">
                                <span>Gratis Ongkir + Diskon 30%</span>
                                <a href="/shop" class="tw-font-semibold tw-text-black tw-no-underline">Belanja Sekarang +</a>
                                <span class="tw-font-semibold tw-text-[#939393]">|</span>
                                <a href="/seller-onboarding" class="tw-font-semibold tw-text-black tw-no-underline">Mulai Berjualan</a>
                                <span class="tw-font-semibold tw-text-[#939393]">|</span>
                                <a href="/unitrade/sponsorship" class="tw-font-semibold tw-text-black tw-no-underline">Sponsorship</a>
                            </div>
                            <div class="tw-flex tw-items-center tw-gap-[18px]">
                                <a href="/faq" class="tw-text-black tw-no-underline">FAQ</a>
                                <a href="/customer-service" class="tw-text-black tw-no-underline">Customer Service</a>
                                <a href="/contactus" class="tw-text-black tw-no-underline">Kontak</a>
                                <span class="tw-font-semibold tw-text-[#939393]">|</span>
                                <span>Ikuti kami :</span>
                                <span class="tw-flex tw-gap-2 tw-text-[12px]">
                                    <i class="fa fa-instagram"></i>
                                    <i class="fa fa-facebook-official"></i>
                                    <i class="fa fa-music"></i>
                                </span>
                            </div>
                        </div>

                        <header class="ut-dash-navbar tw-absolute tw-left-8 tw-right-8 tw-top-[46px] tw-flex tw-h-[70px] tw-items-center tw-rounded-[54px] tw-bg-white tw-px-[14px] tw-shadow-[0_6px_8.95px_rgba(0,0,0,0.05)]">
                            <a href="/" class="tw-flex tw-h-[52px] tw-w-[129px] tw-items-center tw-gap-2 tw-rounded-full tw-px-[15px] tw-text-black tw-no-underline">
                                <img src="/unitrade_theme/static/src/img/logo-unitrade.png" alt="UniTrade" class="tw-h-[37px] tw-w-[41px] tw-object-contain"/>
                                <span class="tw-text-[12px] tw-font-bold">UniTrade</span>
                            </a>
                            <form action="/shop" method="get" class="tw-ml-[25px] tw-flex tw-h-12 tw-flex-1 tw-max-w-[658px] tw-items-center tw-rounded-[22.5px] tw-bg-[#f9f9f9] tw-pl-8 tw-pr-[5px]">
                                <input name="search" type="search" class="tw-min-w-0 tw-flex-1 tw-border-0 tw-bg-transparent tw-text-[12px] tw-text-[#212529] tw-outline-none placeholder:tw-text-[#939393]" placeholder="Cari produk di UniTrade"/>
                                <button type="submit" class="tw-flex tw-size-[38px] tw-items-center tw-justify-center tw-rounded-full tw-border-0 tw-bg-[#212529] tw-text-white" aria-label="Cari">
                                    <i class="fa fa-search"></i>
                                </button>
                            </form>
                            <div class="tw-ml-auto tw-flex tw-items-center tw-gap-[25px]">
                                <a href="/unitrade/seller/chat" class="ut-dash-nav-round tw-relative" aria-label="Chat Pembeli">
                                    <i class="fa fa-commenting-o"></i>
                                    <t t-if="unread_chat_count">
                                        <span class="ut-dash-navbar-dot" t-esc="unread_chat_count if unread_chat_count &lt; 100 else '99+'"></span>
                                    </t>
                                </a>
                                <a href="/shop/cart" class="ut-dash-nav-round" aria-label="Keranjang">
                                    <i class="fa fa-shopping-cart"></i>
                                </a>
                                <a href="/unitrade/seller/orders" class="ut-dash-nav-round tw-relative" aria-label="Notifikasi">
                                    <i class="fa fa-bell-o"></i>
                                    <t t-if="pending_order_count">
                                        <span class="ut-dash-navbar-dot" t-esc="pending_order_count if pending_order_count &lt; 100 else '99+'"></span>
                                    </t>
                                </a>
                                <span class="tw-h-[38.5px] tw-w-px tw-bg-[#e5e7eb]"></span>
                                <a href="/unitrade/seller/dashboard" class="ut-dash-nav-round" aria-label="Dashboard seller">
                                    <i class="fa fa-truck"></i>
                                </a>
                                <a t-att-href="seller_profile_url" class="tw-flex tw-items-center tw-gap-4 tw-text-[#212529] tw-no-underline">
                                    <img t-att-src="seller_avatar_url" alt="Avatar penjual" class="tw-size-[45px] tw-rounded-full tw-object-cover"/>
                                    <span class="tw-mr-5 tw-max-w-[150px] tw-overflow-hidden tw-text-ellipsis tw-whitespace-nowrap tw-text-[16px] tw-font-medium tw-leading-6 tw-text-[#212529]">
                                        <t t-esc="seller.name"/>
                                    </span>
                                </a>
                            </div>
                        </header>

                        <div class="ut-seller-sidebar-owl-host"
                            data-sidebar-active-key="chat"
                            data-sidebar-class="ut-chat-seller-sidebar"
                            t-att-data-incoming-orders="pending_order_count or 0"
                            t-att-data-unread-chat-count="unread_chat_count or 0">
                            <aside class="ut-dash-sidebar ut-seller-shared-sidebar ut-chat-seller-sidebar" aria-label="Menu dashboard penjual">
                                <div class="ut-dash-sidebar-brand">
                                    <span class="ut-dash-sidebar-brand-icon">
                                        <img src="/unitrade_seller/static/src/img/dashboard-icon-brand.svg" alt=""/>
                                    </span>
                                    <span class="ut-dash-sidebar-brand-label">UniTrade</span>
                                </div>
                                <nav class="ut-dash-sidebar-nav">
                                    <span class="ut-dash-sidebar-item ut-chat-skeleton" aria-hidden="true"></span>
                                    <span class="ut-dash-sidebar-item ut-chat-skeleton" aria-hidden="true"></span>
                                    <span class="ut-dash-sidebar-item ut-chat-skeleton" aria-hidden="true"></span>
                                    <span class="ut-dash-sidebar-item ut-chat-skeleton" aria-hidden="true"></span>
                                    <span class="ut-dash-sidebar-item ut-chat-skeleton" aria-hidden="true"></span>
                                </nav>
                            </aside>
                        </div>

                        <main class="ut-dash-main-area ut-chat-seller-main tw-absolute tw-left-[181px] tw-right-[50px] tw-top-[183px] tw-pb-10">
                            <section class="ut-chat-seller-heading">
                                <h1 class="tw-m-0 tw-text-[40px] tw-font-normal tw-leading-none tw-text-black">Chat Pembeli</h1>
                                <p class="tw-m-0 tw-mt-[7px] tw-text-[16px] tw-leading-6 tw-text-[#6a7282]">Here's what's happening with your store today</p>
                            </section>
                            <div id="ut-chat-owl"
                                t-att-data-initial-conversation-id="initial_conversation_id or 0"
                                t-att-data-chat-role="chat_role"
                                t-att-data-base-path="chat_base_path">
                                <div class="ut-chat-shell ut-chat-initial-skeleton" aria-hidden="true">
                                    <aside class="ut-chat-sidebar">
                                        <div class="ut-chat-sidebar-title">
                                            <span class="ut-chat-skeleton-line ut-chat-skeleton ut-is-title"></span>
                                        </div>
                                        <div class="ut-chat-list ut-chat-skeleton-list">
                                            <t t-foreach="[1, 2]" t-as="item">
                                                <div class="ut-chat-list-item ut-chat-skeleton-item">
                                                    <span class="ut-chat-skeleton-avatar ut-chat-skeleton"></span>
                                                    <span class="ut-chat-list-main">
                                                        <span class="ut-chat-skeleton-line ut-chat-skeleton ut-is-title"></span>
                                                        <span class="ut-chat-skeleton-line ut-chat-skeleton ut-is-subtitle"></span>
                                                    </span>
                                                </div>
                                            </t>
                                        </div>
                                    </aside>
                                    <main class="ut-chat-main">
                                        <div class="ut-chat-header ut-chat-skeleton-header">
                                            <span class="ut-chat-skeleton-avatar ut-chat-skeleton"></span>
                                            <div class="ut-chat-header-text">
                                                <span class="ut-chat-skeleton-line ut-chat-skeleton ut-is-title"></span>
                                                <span class="ut-chat-skeleton-line ut-chat-skeleton ut-is-status"></span>
                                            </div>
                                            <span class="ut-chat-skeleton-icon ut-chat-skeleton"></span>
                                        </div>
                                        <div class="ut-chat-messages ut-chat-skeleton-messages">
                                            <div class="ut-chat-message ut-is-theirs">
                                                <span class="ut-chat-skeleton-message-avatar ut-chat-skeleton"></span>
                                                <span class="ut-chat-skeleton-bubble ut-chat-skeleton"></span>
                                            </div>
                                            <div class="ut-chat-message ut-is-mine">
                                                <span class="ut-chat-skeleton-bubble ut-chat-skeleton ut-is-mine"></span>
                                                <span class="ut-chat-skeleton-message-avatar ut-chat-skeleton"></span>
                                            </div>
                                        </div>
                                        <footer class="ut-chat-composer ut-chat-skeleton-composer">
                                            <span class="ut-chat-skeleton-input ut-chat-skeleton"></span>
                                        </footer>
                                    </main>
                                </div>
                            </div>
                        </main>
                    </div>
                </div>
            </t>
            <t t-else="">
                <div class="ut-chat-page tw-bg-[#f7f7f7] tw-font-['Urbanist']">
                    <div id="ut-chat-owl"
                        t-att-data-initial-conversation-id="initial_conversation_id or 0"
                        t-att-data-chat-role="chat_role"
                        t-att-data-base-path="chat_base_path">
                        <div class="ut-chat-shell ut-chat-initial-skeleton" aria-hidden="true">
                            <aside class="ut-chat-sidebar">
                                <div class="ut-chat-sidebar-title">
                                    <span class="ut-chat-skeleton-line ut-chat-skeleton ut-is-title"></span>
                                </div>
                                <div class="ut-chat-list ut-chat-skeleton-list">
                                    <t t-foreach="[1, 2, 3, 4]" t-as="item">
                                        <div class="ut-chat-list-item ut-chat-skeleton-item">
                                            <span class="ut-chat-skeleton-avatar ut-chat-skeleton"></span>
                                            <span class="ut-chat-list-main">
                                                <span class="ut-chat-skeleton-line ut-chat-skeleton ut-is-title"></span>
                                                <span class="ut-chat-skeleton-line ut-chat-skeleton ut-is-subtitle"></span>
                                            </span>
                                        </div>
                                    </t>
                                </div>
                            </aside>
                            <main class="ut-chat-main">
                                <div class="ut-chat-header ut-chat-skeleton-header">
                                    <span class="ut-chat-skeleton-avatar ut-chat-skeleton"></span>
                                    <div class="ut-chat-header-text">
                                        <span class="ut-chat-skeleton-line ut-chat-skeleton ut-is-title"></span>
                                        <span class="ut-chat-skeleton-line ut-chat-skeleton ut-is-status"></span>
                                    </div>
                                    <span class="ut-chat-skeleton-icon ut-chat-skeleton"></span>
                                </div>
                                <div class="ut-chat-messages ut-chat-skeleton-messages">
                                    <div class="ut-chat-message ut-is-theirs">
                                        <span class="ut-chat-skeleton-message-avatar ut-chat-skeleton"></span>
                                        <span class="ut-chat-skeleton-bubble ut-chat-skeleton"></span>
                                    </div>
                                    <div class="ut-chat-message ut-is-mine">
                                        <span class="ut-chat-skeleton-bubble ut-chat-skeleton ut-is-mine"></span>
                                        <span class="ut-chat-skeleton-message-avatar ut-chat-skeleton"></span>
                                    </div>
                                </div>
                                <footer class="ut-chat-composer ut-chat-skeleton-composer">
                                    <span class="ut-chat-skeleton-input ut-chat-skeleton"></span>
                                </footer>
                            </main>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
