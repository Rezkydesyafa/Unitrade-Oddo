<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Server action that opens the website dashboard URL.
         Linked to the Odoo backend menu so admins can land on the
         marketplace dashboard from the standard UniTrade menu tree. -->
    <record id="action_unitrade_admin_dashboard_url" model="ir.actions.act_url">
        <field name="name">Dashboard Admin UniTrade</field>
        <field name="url">/unitrade/admin</field>
        <field name="target">self</field>
    </record>

    <menuitem id="menu_unitrade_admin_dashboard"
              name="Dashboard Admin"
              parent="unitrade_seller.menu_unitrade_root"
              action="action_unitrade_admin_dashboard_url"
              sequence="1"
              groups="base.group_system,unitrade_seller.group_unitrade_admin"/>

</odoo>
